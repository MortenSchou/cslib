/-!
# Linearizations of almost semilinear sets

For a periodic set `P ⊆ ℤ^κ`, its *linearization* is `lin P = (P - P) ∩ ℚ≥0 P`. A linearization of
a set `X = ⋃ (b_j + P_j)` is `⋃ (b_j + lin P_j)`. Linearizations are Presburger sets (semilinear
in the sense of Mathlib), and the main result is that the intersection of linearizations of two
disjoint non-empty almost semilinear sets has strictly smaller dimension than their union.

## Main definitions

* `Cslib.VAS.lin`: `(P - P) ∩ ℚ≥0 P`.
* `Cslib.VAS.IsLinearization`: `S` is a linearization of `X`.
* `Cslib.VAS.AlmostSemilinear`, `Cslib.VAS.IsAlmostSemilinear`: almost semilinear sets.

## Main results

* `Cslib.VAS.IsLinearization.isSemilinearSet_int`, `Cslib.VAS.IsLinearization.isSemilinearSet_nat`:
  linearizations are semilinear.
* `Cslib.VAS.lin_lemma_8_3`: a technical lemma on translates of periodic sets inside `lin P`
  (Leroux, Lemma 8.3).
* `Cslib.VAS.dim_inter_lin_lt`, `Cslib.VAS.dim_inter_linearizations_lt`: Leroux, Corollary 8.4.

## References

* [J. Leroux, *Vector Addition Systems Reachability Problem (A Simpler Solution)*][Leroux2012]
-/

@[expose] public section

open scoped Pointwise

namespace Cslib.VAS

variable {κ : Type*}

/-- The set `(P - P) ∩ ℚ≥0 P ⊆ ℤ^κ` used in linearizations. -/
def lin (P : Set (κ → ℤ)) : Set (κ → ℤ) := (P - P) ∩ {z | ratVec z ∈ ratCone P}

/-- `S` is a *linearization* of `X`: `X = ⋃ (b_j + P_j)` with asymptotically definable periodic
`P_j` and `S = ⋃ (b_j + lin P_j)`. A fixed decomposition is part of the data, since a set can have
several linearizations. -/
def IsLinearization [Fintype κ] (X S : Set (κ → ℤ)) : Prop :=
  ∃ F : Set ((κ → ℤ) × Set (κ → ℤ)), F.Finite ∧ (∀ p ∈ F, IsPeriodic p.2 ∧ AsympDefinable p.2) ∧
    X = ⋃ p ∈ F, p.1 +ᵥ p.2 ∧ S = ⋃ p ∈ F, p.1 +ᵥ lin p.2

/-- Almost semilinear sets: finite unions of `b + P` with `P` periodic and asymptotically
definable, i.e. sets admitting a linearization. -/
def AlmostSemilinear [Fintype κ] (X : Set (κ → ℤ)) : Prop := ∃ S, IsLinearization X S

/-- Almost semilinear sets in the strong sense: every intersection with a Presburger set is almost
semilinear. -/
def IsAlmostSemilinear [Fintype κ] (X : Set (κ → ℤ)) : Prop :=
  ∀ S : Set (κ → ℤ), IsSemilinearSet S → AlmostSemilinear (X ∩ S)

section Lin

variable {P : Set (κ → ℤ)}

theorem mem_lin_iff (hP : IsPeriodic P) {z : κ → ℤ} :
    z ∈ lin P ↔ z ∈ P - P ∧ ∃ n : ℕ, 0 < n ∧ n • z ∈ P := by
  rw [lin, Set.mem_inter_iff]
  exact and_congr_right fun _ => ratVec_mem_ratCone_iff hP

theorem subset_lin (hP : IsPeriodic P) : P ⊆ lin P := fun p hp =>
  (mem_lin_iff hP).2 ⟨⟨p, hp, 0, hP.1, sub_zero p⟩, 1, one_pos, by rwa [one_smul]⟩

theorem lin_subset_sub_self : lin P ⊆ P - P := Set.inter_subset_left

/-- For a periodic set, `P - P` is the subgroup generated by `P`. -/
theorem sub_self_eq_closure (hP : IsPeriodic P) :
    P - P = (AddSubgroup.closure P : Set (κ → ℤ)) := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨p, hp, q, hq, rfl⟩
    exact sub_mem (AddSubgroup.subset_closure hp) (AddSubgroup.subset_closure hq)
  · intro x hx
    induction hx using AddSubgroup.closure_induction with
    | mem x hx => exact ⟨x, hx, 0, hP.1, sub_zero x⟩
    | zero => exact ⟨0, hP.1, 0, hP.1, sub_zero 0⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, ha, b, hb, rfl⟩ := hx
      obtain ⟨c, hc, d, hd, rfl⟩ := hy
      exact ⟨a + c, hP.2 _ ha _ hc, b + d, hP.2 _ hb _ hd, add_sub_add_comm a c b d⟩
    | neg x _ hx =>
      obtain ⟨a, ha, b, hb, rfl⟩ := hx
      exact ⟨b, hb, a, ha, (neg_sub a b).symm⟩

variable [Fintype κ]

omit [Fintype κ] in
/-- Subgroups of `ℤ^κ` are semilinear sets (they are finitely generated). -/
theorem isSemilinearSet_addSubgroup [Finite κ] (H : AddSubgroup (κ → ℤ)) :
    IsSemilinearSet (H : Set (κ → ℤ)) := by
  have h1 : (AddSubgroup.toIntSubmodule H).FG := IsNoetherian.noetherian _
  have h2 : (AddSubgroup.toIntSubmodule H).toAddSubgroup.FG :=
    (Submodule.fg_iff_addSubgroup_fg _).1 h1
  rw [AddSubgroup.toIntSubmodule_toAddSubgroup] at h2
  exact IsSemilinearSet.of_fg ((AddSubgroup.fg_iff_addSubmonoid_fg H).1 h2)

omit [Fintype κ] in
theorem isSemilinearSet_sub_self [Finite κ] (hP : IsPeriodic P) : IsSemilinearSet (P - P) := by
  rw [sub_self_eq_closure hP]
  exact isSemilinearSet_addSubgroup _

/-- The integer points above a rational hyperplane form a semilinear set. -/
theorem isSemilinearSet_setOf_le (a : κ → ℤ) (c : ℤ) :
    IsSemilinearSet {z : κ → ℤ | c ≤ ∑ i, a i * z i} := by
  let f : ((κ → ℤ) × ℕ) →+ ℤ := AddMonoidHom.mk' (fun x => ∑ i, a i * x.1 i) (by
    intro x y
    simp only [Prod.fst_add, Pi.add_apply, mul_add, Finset.sum_add_distrib])
  let g : ((κ → ℤ) × ℕ) →+ ℤ := AddMonoidHom.mk' (fun x => (x.2 : ℤ)) (by
    intro x y
    simp only [Prod.snd_add, Nat.cast_add])
  have h := (isSemilinearSet_setOfPred_eq (M := (κ → ℤ) × ℕ) (0 : ℤ) c f g).image
    (AddMonoidHom.fst (κ → ℤ) ℕ)
  convert h using 1
  ext z
  simp only [Set.mem_ofPred_eq, Set.mem_image]
  constructor
  · intro hz
    refine ⟨(z, (∑ i, a i * z i - c).toNat), ?_, rfl⟩
    simp only [f, g, AddMonoidHom.mk'_apply, zero_add]
    rw [Int.toNat_of_nonneg (sub_nonneg.2 hz)]
    ring
  · rintro ⟨⟨z', t⟩, h, rfl⟩
    simp only [f, g, AddMonoidHom.mk'_apply, zero_add] at h
    change c ≤ ∑ i, a i * z' i
    rw [h]
    exact le_add_of_nonneg_right (Int.natCast_nonneg t)

/-- A single linear constraint evaluated at an integer point is a semilinear condition. -/
theorem isSemilinearSet_holds (g : LinCons κ) :
    IsSemilinearSet {z : κ → ℤ | g.Holds (ratVec z)} := by
  have key : ∀ z : κ → ℤ, ∑ i, (g.coeff i : ℚ) * ratVec z i = ((∑ i, g.coeff i * z i : ℤ) : ℚ) := by
    intro z
    simp only [ratVec, Int.cast_sum, Int.cast_mul]
  cases hs : g.strict
  · convert isSemilinearSet_setOf_le g.coeff 0 using 1
    ext z
    simp only [Set.mem_ofPred_eq, LinCons.holds_of_not_strict hs, key]
    exact_mod_cast Iff.rfl
  · convert isSemilinearSet_setOf_le g.coeff 1 using 1
    ext z
    simp only [Set.mem_ofPred_eq, LinCons.holds_of_strict hs, key, Int.cast_pos]
    omega

/-- The integer points of an asymptotically definable cone form a semilinear set. -/
theorem isSemilinearSet_cone (hd : AsympDefinable P) :
    IsSemilinearSet {z : κ → ℤ | ratVec z ∈ ratCone P} := by
  classical
  obtain ⟨S, hS⟩ := hd
  have : {z : κ → ℤ | ratVec z ∈ ratCone P} =
      ⋃ s ∈ S.toFinset, ⋂ g ∈ s.toFinset, {z | g.Holds (ratVec z)} := by
    ext z
    simp [hS]
  rw [this]
  exact IsSemilinearSet.biUnion_finset fun s _ =>
    IsSemilinearSet.biInter_finset fun g _ => isSemilinearSet_holds g

/-- `lin P` is a semilinear set: it is the intersection of a subgroup of `ℤ^κ` and the integer
points of a rationally definable cone. -/
theorem isSemilinearSet_lin (hP : IsPeriodic P) (hd : AsympDefinable P) :
    IsSemilinearSet (lin P) :=
  (isSemilinearSet_sub_self hP).inter (isSemilinearSet_cone hd)

/-- A linearization contains the set it linearizes. -/
theorem IsLinearization.subset {X S : Set (κ → ℤ)} (h : IsLinearization X S) : X ⊆ S := by
  obtain ⟨F, -, hF, rfl, rfl⟩ := h
  refine Set.iUnion₂_mono fun p hp => ?_
  exact Set.vadd_set_mono (subset_lin (hF p hp).1)

/-- Linearizations are Presburger sets, as `ℤ^κ`-semilinear sets in Mathlib's sense
(the passage from groups and rational cones to semilinear sets). -/
theorem IsLinearization.isSemilinearSet_int {X S : Set (κ → ℤ)} (h : IsLinearization X S) :
    IsSemilinearSet S := by
  obtain ⟨F, hF, hP, -, rfl⟩ := h
  exact IsSemilinearSet.biUnion hF fun p hp =>
    (isSemilinearSet_lin (hP p hp).1 (hP p hp).2).vadd p.1

/-- Linearizations are Presburger sets of configurations: the preimage under the inclusion
`ℕ^ι → ℤ^ι` of a semilinear set is semilinear. -/
theorem IsLinearization.isSemilinearSet_nat {ι : Type*} [Fintype ι] {X S : Set (ι → ℤ)}
    (h : IsLinearization X S) : IsSemilinearSet {c : VASConfig ι | c.toInt ∈ S} :=
  h.isSemilinearSet_int.preimage (AddMonoidHom.compLeft (Nat.castAddMonoidHom ℤ) ι)

end Lin

section Dim

variable [Finite κ]

/-- A non-empty semilinear set contains a linear set of the same dimension. -/
theorem exists_linear_subset_dim {Z : Set (κ → ℤ)} (hZ : IsSemilinearSet Z) (hne : Z.Nonempty) :
    ∃ (b : κ → ℤ) (M : Finset (κ → ℤ)),
      b +ᵥ (AddSubmonoid.closure (M : Set (κ → ℤ)) : Set (κ → ℤ)) ⊆ Z ∧
        dim (b +ᵥ (AddSubmonoid.closure (M : Set (κ → ℤ)) : Set (κ → ℤ))) = dim Z := by
  obtain ⟨𝒮, h𝒮, hlin, rfl⟩ := hZ
  obtain ⟨x, t₀, ht₀, hx⟩ := hne
  obtain ⟨t, ht, hmax⟩ := h𝒮.toFinset.exists_max_image dim ⟨t₀, h𝒮.mem_toFinset.2 ht₀⟩
  rw [h𝒮.mem_toFinset] at ht
  obtain ⟨a, T, hT, rfl⟩ := hlin t ht
  refine ⟨a, hT.toFinset, ?_, ?_⟩
  · rw [hT.coe_toFinset]
    exact Set.subset_sUnion_of_mem ht
  · rw [hT.coe_toFinset]
    refine le_antisymm (dim_mono (Set.subset_sUnion_of_mem ht)) ?_
    rw [Set.sUnion_eq_biUnion]
    exact dim_biUnion_le h𝒮 fun t' ht' => hmax t' (h𝒮.mem_toFinset.2 ht')

end Dim

section Lemma83

/-- A vector in the rational span of a finite set of integer vectors has a multiple that is an
integer combination of that set. -/
theorem exists_int_comb (F : Finset (κ → ℤ)) {p : κ → ℤ}
    (hp : ratVec p ∈ Submodule.span ℚ (ratVec '' (F : Set (κ → ℤ)))) :
    ∃ z : ℕ, 0 < z ∧ ∃ d : (κ → ℤ) → ℤ, z • p = ∑ m ∈ F, d m • m := by
  obtain ⟨⟨t, ht⟩, hx⟩ := multiple_mem_span_of_mem_localization_span (Submonoid.pos ℤ) ℚ _ _ hp
  obtain ⟨d, hd⟩ := (Submodule.mem_span_image_finset_iff_exists_fun' ℤ).1 hx
  have ht : 0 < t := ht
  refine ⟨t.toNat, by omega, d, ratVec_injective ?_⟩
  simp only [ratVec_nsmul, ratVec_sum, ratVec_zsmul, Int.cast_smul_eq_zsmul ℚ]
  rw [show (t.toNat : ℚ) = (t : ℤ) by exact_mod_cast Int.toNat_of_nonneg ht.le,
    Int.cast_smul_eq_zsmul ℚ]
  exact hd.symm

/-- **Lemma 8.3** (Leroux): if `b + M ⊆ (P - P) ∩ ℚ≥0 P` for periodic `M, P`, and `F ⊆ M` is a
finite set whose rational span contains `P`, then some positive multiple `k a` of the sum `a` of `F`
satisfies `b + k n a ∈ P` for all `n > 0`.

Compared to the statement in the paper, the hypothesis that `a` is in the span of `M` is dropped
(it is implied by `a ∈ M`). -/
theorem lin_lemma_8_3 {b : κ → ℤ} {M P : Set (κ → ℤ)} (hM : IsPeriodic M) (hP : IsPeriodic P)
    (hb : b +ᵥ M ⊆ lin P) (F : Finset (κ → ℤ)) (hF : (F : Set (κ → ℤ)) ⊆ M)
    (hspan : Submodule.span ℚ (ratVec '' P) ≤ Submodule.span ℚ (ratVec '' (F : Set (κ → ℤ)))) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, 0 < n → b + (k * n) • ∑ m ∈ F, m ∈ P := by
  have hb0 : b ∈ lin P := by simpa using hb (Set.mem_vadd_set.2 ⟨0, hM.1, rfl⟩)
  obtain ⟨⟨pp, hpp, pm, hpm, hbpp⟩, -⟩ := hb0
  obtain ⟨z, hz, d, hzd⟩ := exists_int_comb F (hspan (Submodule.subset_span ⟨pp, hpp, rfl⟩))
  obtain ⟨z, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hz.ne'
  -- a large natural number bounding the coefficients
  set N : ℕ := ∑ m ∈ F, (d m).natAbs + 1 with hN
  have hdN : ∀ m ∈ F, d m ≤ N := fun m hm => by
    have : (d m).natAbs ≤ ∑ m ∈ F, (d m).natAbs :=
      Finset.single_le_sum (f := fun m => (d m).natAbs) (fun _ _ => Nat.zero_le _) hm
    omega
  set a := ∑ m ∈ F, m with ha
  set x : κ → ℤ := ∑ m ∈ F, (((N : ℤ) - d m).toNat) • m with hx_def
  have hxM : x ∈ M := hM.sum_mem _ _ fun m hm => hM.nsmul_mem (hF hm) _
  have hx : x = (N : ℤ) • a - z.succ • pp := by
    rw [hzd, ha, Finset.smul_sum, ← Finset.sum_sub_distrib, hx_def]
    refine Finset.sum_congr rfl fun m hm => ?_
    rw [← natCast_zsmul, Int.toNat_of_nonneg (sub_nonneg.2 (hdN m hm)), sub_smul]
  have hbpp' : pp - pm = b := hbpp
  -- `-pm + N a` lies in the cone of `P`
  have hcone : ratVec (-pm + (N : ℤ) • a) ∈ ratCone P := by
    have h2 := ratCone_add_mem_of_mem hP (hb (Set.mem_vadd_set.2 ⟨x, hxM, rfl⟩)).2
      (hP.nsmul_mem hpp z)
    rw [vadd_eq_add, ← ratVec_add] at h2
    convert h2 using 2
    rw [hx, ← hbpp', succ_nsmul]
    abel
  obtain ⟨s, hs, hsP⟩ := (ratVec_mem_ratCone_iff hP).1 hcone
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hs.ne'
  set K : ℕ := (s + 1) * N with hK
  have hu : -pm + (K : ℤ) • a ∈ P := by
    convert hP.2 _ hsP _ (hP.nsmul_mem hpm s) using 1
    simp only [hK, ← natCast_zsmul]
    push_cast
    module
  have hKa : (K : ℤ) • a ∈ P := by simpa using hP.2 _ hu _ hpm
  refine ⟨K, Nat.mul_pos s.succ_pos (Nat.succ_pos _), fun n hn => ?_⟩
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
  convert hP.2 _ (hP.2 _ hpp _ hu) _ (hP.nsmul_mem hKa n) using 1
  rw [← hbpp']
  simp only [← natCast_zsmul]
  push_cast
  module

end Lemma83

section Corollary84

theorem ratVec_mem_span_of_mem_lin {P : Set (κ → ℤ)} {y : κ → ℤ} (hy : y ∈ lin P) :
    ratVec y ∈ Submodule.span ℚ (ratVec '' P) := by
  obtain ⟨⟨p, hp, q, hq, rfl⟩, -⟩ := hy
  rw [ratVec_sub]
  exact Submodule.sub_mem _ (Submodule.subset_span ⟨p, hp, rfl⟩)
    (Submodule.subset_span ⟨q, hq, rfl⟩)

/-- If `b + M ⊆ lin P` then the vector space generated by `M` is contained in that of `P`. -/
theorem span_le_of_vadd_subset_lin {b : κ → ℤ} {M P : Set (κ → ℤ)} (hM : IsPeriodic M)
    (h : b +ᵥ M ⊆ lin P) : Submodule.span ℚ (ratVec '' M) ≤ Submodule.span ℚ (ratVec '' P) := by
  rw [Submodule.span_le]
  rintro _ ⟨m, hm, rfl⟩
  have h1 := ratVec_mem_span_of_mem_lin (h (Set.mem_vadd_set.2 ⟨m, hm, rfl⟩))
  have h0 := ratVec_mem_span_of_mem_lin
    (h (Set.mem_vadd_set.2 ⟨0, hM.1, by rw [vadd_eq_add, add_zero]⟩))
  have := Submodule.sub_mem _ h1 h0
  rwa [vadd_eq_add, ratVec_add, add_sub_cancel_left] at this

/-- The span of the closure of a finite set is spanned by the finite set. -/
theorem span_closure_le (M : Finset (κ → ℤ)) :
    Submodule.span ℚ (ratVec '' (AddSubmonoid.closure (M : Set (κ → ℤ)) : Set (κ → ℤ))) ≤
      Submodule.span ℚ (ratVec '' (M : Set (κ → ℤ))) := by
  rw [Submodule.span_le]
  rintro _ ⟨m, hm, rfl⟩
  induction hm using AddSubmonoid.closure_induction with
  | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
  | zero => rw [ratVec_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [ratVec_add]; exact Submodule.add_mem _ hx hy

/-- **Corollary 8.4, atomic form** (Leroux): for asymptotically definable periodic `P₁, P₂` with
`(b₁ + P₁) ∩ (b₂ + P₂) = ∅`, the intersection of the linearized translates has dimension strictly
below the larger of the two dimensions. -/
theorem dim_inter_lin_lt [Fintype κ] {b₁ b₂ : κ → ℤ} {P₁ P₂ : Set (κ → ℤ)} (h₁ : IsPeriodic P₁)
    (h₂ : IsPeriodic P₂) (d₁ : AsympDefinable P₁) (d₂ : AsympDefinable P₂)
    (hdisj : (b₁ +ᵥ P₁) ∩ (b₂ +ᵥ P₂) = ∅) :
    dim ((b₁ +ᵥ lin P₁) ∩ (b₂ +ᵥ lin P₂)) < max (dim (b₁ +ᵥ P₁)) (dim (b₂ +ᵥ P₂)) := by
  have hD₁ : dim (b₁ +ᵥ P₁) = (Module.finrank ℚ (Submodule.span ℚ (ratVec '' P₁)) : ℕ) := by
    rw [dim_vadd, dim_periodic h₁]
  have hD₂ : dim (b₂ +ᵥ P₂) = (Module.finrank ℚ (Submodule.span ℚ (ratVec '' P₂)) : ℕ) := by
    rw [dim_vadd, dim_periodic h₂]
  have hZ : IsSemilinearSet ((b₁ +ᵥ lin P₁) ∩ (b₂ +ᵥ lin P₂)) :=
    ((isSemilinearSet_lin h₁ d₁).vadd b₁).inter ((isSemilinearSet_lin h₂ d₂).vadd b₂)
  by_cases hne : ((b₁ +ᵥ lin P₁) ∩ (b₂ +ᵥ lin P₂)).Nonempty
  swap
  · rw [Set.not_nonempty_iff_eq_empty.1 hne, dim_empty, hD₁]
    exact lt_max_of_lt_left (WithBot.bot_lt_coe _)
  obtain ⟨b, M, hsub, hdim⟩ := exists_linear_subset_dim hZ hne
  set M' : Set (κ → ℤ) := (AddSubmonoid.closure (M : Set (κ → ℤ)) : Set (κ → ℤ)) with hM'
  have hMper : IsPeriodic M' := isPeriodic_closure _
  -- the translates of `M'` inside the two linearizations
  have hsub₁ : (b - b₁) +ᵥ M' ⊆ lin P₁ := by
    simpa [vadd_vadd, neg_add_eq_sub] using
      Set.subset_vadd_set_iff.1 (hsub.trans Set.inter_subset_left)
  have hsub₂ : (b - b₂) +ᵥ M' ⊆ lin P₂ := by
    simpa [vadd_vadd, neg_add_eq_sub] using
      Set.subset_vadd_set_iff.1 (hsub.trans Set.inter_subset_right)
  set W := Submodule.span ℚ (ratVec '' M') with hW
  have hW₁ : W ≤ Submodule.span ℚ (ratVec '' P₁) := span_le_of_vadd_subset_lin hMper hsub₁
  have hW₂ : W ≤ Submodule.span ℚ (ratVec '' P₂) := span_le_of_vadd_subset_lin hMper hsub₂
  have hnot : ¬ (W = Submodule.span ℚ (ratVec '' P₁) ∧ W = Submodule.span ℚ (ratVec '' P₂)) := by
    rintro ⟨e₁, e₂⟩
    have hMM : (M : Set (κ → ℤ)) ⊆ M' := AddSubmonoid.subset_closure
    obtain ⟨k₁, hk₁, hk₁'⟩ := lin_lemma_8_3 hMper h₁ hsub₁ M hMM (e₁ ▸ span_closure_le M)
    obtain ⟨k₂, hk₂, hk₂'⟩ := lin_lemma_8_3 hMper h₂ hsub₂ M hMM (e₂ ▸ span_closure_le M)
    have m₁ := hk₁' k₂ hk₂
    have m₂ := hk₂' k₁ hk₁
    rw [mul_comm k₂ k₁] at m₂
    have : b + (k₁ * k₂) • ∑ m ∈ M, m ∈ (b₁ +ᵥ P₁) ∩ (b₂ +ᵥ P₂) := by
      refine ⟨Set.mem_vadd_set.2 ⟨_, m₁, ?_⟩, Set.mem_vadd_set.2 ⟨_, m₂, ?_⟩⟩ <;>
        rw [vadd_eq_add] <;> abel
    rwa [hdisj] at this
  rw [← hdim, dim_vadd, dim_periodic hMper]
  rw [Classical.not_and_iff_not_or_not] at hnot
  rcases hnot with hn | hn
  · refine lt_max_of_lt_left ?_
    rw [hD₁]
    exact_mod_cast Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hW₁ hn)
  · refine lt_max_of_lt_right ?_
    rw [hD₂]
    exact_mod_cast Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hW₂ hn)

/-- **Corollary 8.4** (Leroux): for disjoint non-empty almost semilinear sets, the intersection of
any two linearizations has strictly smaller dimension than the union. -/
theorem dim_inter_linearizations_lt [Fintype κ] {X Y S T : Set (κ → ℤ)}
    (hX : IsLinearization X S) (hY : IsLinearization Y T) (hXne : X.Nonempty)
    (hYne : Y.Nonempty) (hdisj : X ∩ Y = ∅) : dim (S ∩ T) < dim (X ∪ Y) := by
  obtain ⟨F, hF, hFp, rfl, rfl⟩ := hX
  obtain ⟨G, hG, hGp, rfl, rfl⟩ := hY
  obtain ⟨m, hm⟩ := exists_dim_eq (hXne.mono Set.subset_union_left)
  have hd : ⊥ < dim ((⋃ p ∈ F, p.1 +ᵥ p.2) ∪ ⋃ p ∈ G, p.1 +ᵥ p.2) := by
    rw [hm]; exact WithBot.bot_lt_coe m
  simp only [Set.iUnion_inter, Set.inter_iUnion]
  refine dim_biUnion_lt hG hd fun q hq => dim_biUnion_lt hF hd fun p hp => ?_
  have hdis : (p.1 +ᵥ p.2) ∩ (q.1 +ᵥ q.2) = ∅ := by
    refine Set.eq_empty_of_subset_empty ?_
    rw [← hdisj]
    exact Set.inter_subset_inter (Set.subset_iUnion₂ (s := fun p (_ : p ∈ F) => p.1 +ᵥ p.2) p hp)
      (Set.subset_iUnion₂ (s := fun q (_ : q ∈ G) => q.1 +ᵥ q.2) q hq)
  refine (dim_inter_lin_lt (hFp p hp).1 (hGp q hq).1 (hFp p hp).2 (hGp q hq).2 hdis).trans_le ?_
  refine max_le (dim_mono ?_) (dim_mono ?_)
  · exact (Set.subset_iUnion₂ (s := fun p (_ : p ∈ F) => p.1 +ᵥ p.2) p hp).trans
      Set.subset_union_left
  · exact (Set.subset_iUnion₂ (s := fun q (_ : q ∈ G) => q.1 +ᵥ q.2) q hq).trans
      Set.subset_union_right

end Corollary84

