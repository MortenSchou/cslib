module

public import Cslib.Init
public import Mathlib.Algebra.Group.Pi.Basic
public import Mathlib.Algebra.Group.Submonoid.BigOperators
public import Mathlib.Algebra.Module.Pi
public import Mathlib.Algebra.Order.Field.Rat

/-!
# Periodic sets and rational cones

Basic vocabulary shared by the files on transformer relations and on asymptotic definability.

* `Cslib.VAS.IsPeriodic`: periodic sets (contain `0`, closed under `+`).
* `Cslib.VAS.IsPeriodic.toAddSubmonoid`: a periodic set is an additive submonoid, so it is closed
  under natural multiples and finite sums.
* `Cslib.VAS.ratVec`, `Cslib.VAS.ratCone`: the rational view of an integer vector and the cone
  `ℚ≥0 P` generated by a set `P ⊆ ℤ^κ`.
-/

@[expose] public section

namespace Cslib.VAS

/-- A periodic set: contains `0` and is closed under `+`. -/
def IsPeriodic {E : Type*} [AddCommMonoid E] (P : Set E) : Prop :=
  0 ∈ P ∧ ∀ p ∈ P, ∀ q ∈ P, p + q ∈ P

/-- Every additive submonoid is periodic. -/
theorem isPeriodic_coe {E : Type*} [AddCommMonoid E] (M : AddSubmonoid E) :
    IsPeriodic (M : Set E) :=
  ⟨M.zero_mem, fun _ hp _ hq => M.add_mem hp hq⟩

namespace IsPeriodic

variable {E : Type*} [AddCommMonoid E] {P : Set E}

/-- A periodic set is (the carrier of) an additive submonoid. -/
def toAddSubmonoid (hP : IsPeriodic P) : AddSubmonoid E where
  carrier := P
  zero_mem' := hP.1
  add_mem' hp hq := hP.2 _ hp _ hq

/-- Periodic sets are closed under natural multiples. -/
theorem nsmul_mem (hP : IsPeriodic P) {p : E} (hp : p ∈ P) (n : ℕ) : n • p ∈ P :=
  hP.toAddSubmonoid.nsmul_mem hp n

/-- Periodic sets are closed under finite sums. -/
theorem sum_mem (hP : IsPeriodic P) {α : Type*} (s : Finset α) (f : α → E)
    (h : ∀ a ∈ s, f a ∈ P) : ∑ a ∈ s, f a ∈ P :=
  hP.toAddSubmonoid.sum_mem h

/-- The intersection of two periodic sets is periodic. -/
theorem inter {Q : Set E} (hP : IsPeriodic P) (hQ : IsPeriodic Q) : IsPeriodic (P ∩ Q) :=
  ⟨⟨hP.1, hQ.1⟩, fun _ hp _ hq => ⟨hP.2 _ hp.1 _ hq.1, hQ.2 _ hp.2 _ hq.2⟩⟩

end IsPeriodic

/-- Rational view of an integer vector. -/
def ratVec {κ : Type*} (z : κ → ℤ) : κ → ℚ := fun i => (z i : ℚ)

/-- The conic set `ℚ≥0 P` generated by `P ⊆ ℤ^κ`. -/
def ratCone {κ : Type*} (P : Set (κ → ℤ)) : Set (κ → ℚ) :=
  {v | ∃ q : ℚ, 0 ≤ q ∧ ∃ p ∈ P, v = q • ratVec p}

end Cslib.VAS
