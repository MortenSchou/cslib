module

public import Cslib.Computability.PetriNets.StateEquation
public import Cslib.Computability.PetriNets.Structure

/-! # Conflict-free nets

A net is *conflict-free* if every place is an input of at most one transition (Landweber and
Robertson). Then no two distinct transitions compete for tokens, so firing one transition never
disables another: conflict-free nets are *persistent*. (Landweber and Robertson also allow a place
shared by several transitions when it lies on a self-loop with each of them; we use the simpler
structural condition.)

A *firing count vector* is a multiset of transitions; the firing count vector of a firing sequence
`ts` is `(ts : Multiset Transition)`.

## Main definitions

- `PetriNet.ConflictFree`: every place has at most one consumer transition.
- `PetriNet.Firable`: a firing count vector is the firing count vector of a firing sequence from
  `M`.

## Main statements

- `PetriNet.ConflictFree.enabled_fires`: persistence.
- `PetriNet.ConflictFree.diamond`: two enabled distinct transitions commute.
- `PetriNet.ConflictFree.exists_mTr_of_le`: a firing sequence whose firing counts stay below
  those of a firing sequence `ts` can be completed to realise the firing count vector of `ts`
  (and reaches the same marking).
- `PetriNet.ConflictFree.coe_eq_of_maximal`: a firing sequence inside `σ` that cannot be
  extended inside `σ` realises `σ`, if `σ` is firable at all. So firing greedily inside `σ` never
  needs to backtrack.
- `PetriNet.Firable.stateEquation_and_siphons`: necessity of the siphon condition.
- `PetriNet.ConflictFree.firable_iff`, `PetriNet.ConflictFree.reachable_iff_siphons`: the
  Landweber–Robertson characterisation, when arcs into transitions have weight at most one.
- `PetriNet.reachable_iff_exists_firable`: reachability is firability of a solution of the state
  equation.

## Landweber–Robertson

In a conflict-free net whose arcs into transitions have weight at most one, a vector `σ` is firable
at `M₀` iff `Σ_{t ∈ σ} pre t ≤ M₀ + Σ_{t ∈ σ} post t` and every nonempty siphon of the subnet
generated by `σ` (the transitions of `σ` and the places they touch) is marked at `M₀`. The weight
bound is necessary: with one place and a transition consuming two tokens and producing one,
`σ = {t}` satisfies the state equation at one token and the siphon is marked, but nothing fires
(`Example.weighted_not_firable`). The sufficiency proof takes a greedy sequence inside `σ` that
is stuck, and shows that the empty input places of the remaining transition(s) with fewest firings
so far form an unmarked siphon (`ConflictFree.exists_unmarked_siphon`). Arbitrary weights on `post`
are allowed.

## References

* [L. H. Landweber and E. L. Robertson, *Properties of conflict-free and persistent Petri
  nets*][LandweberRobertson1978]
-/

@[expose] public section

namespace Cslib

namespace PetriNet

open scoped PetriNet

variable {Place : Type*} {Transition : Type*}

/-- A net is conflict-free if every place is an input of at most one transition. -/
def ConflictFree (N : PetriNet Place Transition) : Prop :=
  ∀ t u p, p ∈ •[N] t → p ∈ •[N] u → t = u

namespace ConflictFree

variable {N : PetriNet Place Transition}

/-- Persistence: in a conflict-free net, firing a transition never disables another one. -/
theorem enabled_fires (hcf : N.ConflictFree) {M M' : Marking Place} {t u : Transition}
    (ht : M [t⟩[N]) (hu : M [u⟩[N] M') (hne : t ≠ u) : M' [t⟩[N] := by
  classical
  obtain ⟨R, rfl, rfl⟩ := hu
  refine Multiset.le_iff_count.2 fun p => ?_
  have h := Multiset.le_iff_count.1 ht p
  rw [Multiset.count_add] at h ⊢
  by_cases hp : p ∈ •[N] u
  · rw [Multiset.count_eq_zero.2 fun hpt => hne (hcf t u p hpt hp)]
    exact Nat.zero_le _
  · rw [Multiset.count_eq_zero.2 hp] at h
    omega

/-- Two distinct transitions that are enabled at a marking can be fired in either order, with the
same result. -/
theorem diamond (hcf : N.ConflictFree) {M M₁ M₂ : Marking Place} {t u : Transition}
    (h₁ : M [t⟩[N] M₁) (h₂ : M [u⟩[N] M₂) (hne : t ≠ u) :
    ∃ M₃, M₁ [u⟩[N] M₃ ∧ M₂ [t⟩[N] M₃ := by
  have e₁ := enabled_iff_exists_fires.2 ⟨_, h₁⟩
  have e₂ := enabled_iff_exists_fires.2 ⟨_, h₂⟩
  obtain ⟨M₃, h₃⟩ := enabled_iff_exists_fires.1 (hcf.enabled_fires e₂ h₁ hne.symm)
  obtain ⟨M₄, h₄⟩ := enabled_iff_exists_fires.1 (hcf.enabled_fires e₁ h₂ hne)
  have : M₃ = M₄ := by
    apply add_right_cancel (b := •[N] u + •[N] t)
    calc M₃ + (•[N] u + •[N] t) = (M₃ + •[N] u) + •[N] t := by abel
      _ = (M₁ + •[N] t) + u •[N] := by rw [h₃.add_pre]; abel
      _ = (M₂ + •[N] u) + t •[N] := by rw [h₁.add_pre, h₂.add_pre]; abel
      _ = (M₄ + •[N] t) + •[N] u := by rw [h₄.add_pre]; abel
      _ = M₄ + (•[N] u + •[N] t) := by abel
  exact ⟨M₃, h₃, this ▸ h₄⟩

/-- A transition occurring in a firing sequence and enabled at its start can be moved to the
front. -/
theorem slide (hcf : N.ConflictFree) {M M₁ M' : Marking Place} {u : Transition}
    {ts : List Transition} (hts : N.lts.MTr M ts M') (hu : M [u⟩[N] M₁) (hmem : u ∈ ts) :
    ∃ ts', N.lts.MTr M₁ ts' M' ∧ (ts : Multiset Transition) = u ::ₘ ts' := by
  induction hts generalizing M₁ with
  | refl => simp at hmem
  | @stepL M t M₂ ts M' htr hrest ih =>
    by_cases htu : t = u
    · subst htu
      have : M₂ = M₁ := LTS.Deterministic.deterministic (lts := N.lts) _ _ _ _ htr hu
      subst this
      exact ⟨ts, hrest, rfl⟩
    · obtain ⟨M₃, h₃, h₄⟩ := hcf.diamond htr hu htu
      obtain ⟨ts', h', hp⟩ := ih h₃ ((List.mem_cons.1 hmem).resolve_left (Ne.symm htu))
      refine ⟨t :: ts', .stepL h₄ h', ?_⟩
      rw [← Multiset.cons_coe, ← Multiset.cons_coe, hp, Multiset.cons_swap]

/-- The completion theorem: if `ts` fires from `M` and `us` fires from `M` using each transition at
most as often as `ts`, then `us` can be completed to a firing sequence with the firing count
vector of `ts`, reaching the same marking as `ts`. -/
theorem exists_mTr_of_le (hcf : N.ConflictFree) {M K M' : Marking Place} {ts us : List Transition}
    (hts : N.lts.MTr M ts M') (hus : N.lts.MTr M us K)
    (hle : (us : Multiset Transition) ≤ ts) :
    ∃ vs, N.lts.MTr K vs M' ∧ (us : Multiset Transition) + vs = ts := by
  induction hus generalizing ts with
  | refl => exact ⟨ts, hts, zero_add _⟩
  | @stepL M u M₁ us K htr hrest ih =>
    have hmem : u ∈ ts :=
      Multiset.mem_coe.1 (Multiset.mem_of_le hle (Multiset.mem_coe.2 List.mem_cons_self))
    obtain ⟨ts', hts', hp⟩ := hcf.slide hts htr hmem
    rw [← Multiset.cons_coe, hp, Multiset.cons_le_cons_iff] at hle
    obtain ⟨vs, hvs, hvp⟩ := ih hts' hle
    refine ⟨vs, hvs, ?_⟩
    rw [hp, ← hvp, ← Multiset.cons_coe, Multiset.cons_add]

end ConflictFree

/-- A firing count vector `σ` is firable at `M` if it is the firing count vector of some firing
sequence from `M`. -/
def Firable (N : PetriNet Place Transition) (M : Marking Place) (σ : Multiset Transition) :
    Prop :=
  ∃ ts K, N.lts.MTr M ts K ∧ (ts : Multiset Transition) = σ

namespace ConflictFree

variable {N : PetriNet Place Transition}

/-- Greedy firing inside a firable vector `σ` cannot get stuck: a firing sequence inside `σ` that
cannot be extended inside `σ` has firing count vector `σ`. -/
theorem coe_eq_of_maximal (hcf : N.ConflictFree) {M K : Marking Place} {σ : Multiset Transition}
    {us : List Transition} (hσ : N.Firable M σ) (hus : N.lts.MTr M us K)
    (hle : (us : Multiset Transition) ≤ σ) (hmax : ∀ t, K [t⟩[N] → ¬ t ::ₘ us ≤ σ) :
    (us : Multiset Transition) = σ := by
  obtain ⟨ts, M', hts, rfl⟩ := hσ
  obtain ⟨vs, hvs, hp⟩ := hcf.exists_mTr_of_le hts hus hle
  cases hvs with
  | refl => simpa using hp
  | @stepL _ t K₁ vs _ htr _ =>
    refine absurd ?_ (hmax t (enabled_iff_exists_fires.2 ⟨_, htr⟩))
    rw [← hp, ← Multiset.cons_coe, Multiset.add_cons, Multiset.cons_le_cons_iff]
    exact Multiset.le_add_right _ _

end ConflictFree

/-- Reachability is firability of a solution of the state equation. -/
theorem reachable_iff_exists_firable {N : PetriNet Place Transition} {M M' : Marking Place} :
    M ⇝[N] M' ↔ ∃ σ : Multiset Transition,
      N.Firable M σ ∧ M' + (σ.map N.pre).sum = M + (σ.map N.post).sum := by
  constructor
  · rintro ⟨ts, hts⟩
    exact ⟨ts, ⟨ts, M', hts, rfl⟩, mTr_add_sum_pre hts⟩
  · rintro ⟨σ, ⟨ts, K, hts, rfl⟩, h⟩
    have : M' = K := add_right_cancel (h.trans (mTr_add_sum_pre hts).symm)
    exact this ▸ ⟨ts, hts⟩

section LandweberRobertson

variable {N : PetriNet Place Transition}

/-- The places touched by the transitions of `σ`: the places of the subnet generated by `σ`. -/
def supportPlaces (N : PetriNet Place Transition) (σ : Multiset Transition) : Set Place :=
  {p | ∃ t ∈ σ, p ∈ •[N] t ∨ p ∈ t •[N]}

/-- A siphon of the subnet generated by `σ`: a set of places of that subnet such that every
transition of `σ` that produces into the set also consumes from it. -/
def IsSupportSiphon (N : PetriNet Place Transition) (σ : Multiset Transition) (S : Set Place) :
    Prop :=
  S ⊆ N.supportPlaces σ ∧ ∀ t ∈ σ, (∃ p ∈ S, p ∈ t •[N]) → ∃ q ∈ S, q ∈ •[N] t

/-- In a conflict-free net, the only consumer of `p` is `t`, so a firing count vector `σ` takes
`σ.count t * (•[N] t).count p` tokens from `p`. -/
theorem ConflictFree.count_sum_pre [DecidableEq Place] [DecidableEq Transition]
    (hcf : N.ConflictFree) {t : Transition} {p : Place} (hp : p ∈ •[N] t)
    (σ : Multiset Transition) : ((σ.map N.pre).sum).count p = σ.count t * (•[N] t).count p := by
  rw [Multiset.count_sum, Finset.sum_multiset_map_count, Finset.sum_eq_single t, smul_eq_mul]
  · intro u _ hut
    rw [Multiset.count_eq_zero.2 fun hpu => hut (hcf u t p hpu hp), smul_zero]
  · intro ht
    rw [Multiset.count_eq_zero.2 (by simpa using ht), zero_smul]

/-- A siphon of the subnet generated by `σ` that is unmarked stays unmarked along a firing
sequence of transitions of `σ`, and no transition of the sequence touches it. -/
theorem unmarked_of_mTr {M K : Marking Place} {ts : List Transition} {σ : Multiset Transition}
    {S : Set Place} (hsip : ∀ t ∈ σ, (∃ p ∈ S, p ∈ t •[N]) → ∃ q ∈ S, q ∈ •[N] t)
    (h : N.lts.MTr M ts K) (hts : ∀ t ∈ ts, t ∈ σ) (hM : ∀ p ∈ S, p ∉ M) :
    ∀ t ∈ ts, ∀ p ∈ S, p ∉ •[N] t ∧ p ∉ t •[N] := by
  induction h with
  | refl => simp
  | @stepL M t M₁ ts K htr _ ih =>
    obtain ⟨R, rfl, rfl⟩ := htr
    have hpre : ∀ p ∈ S, p ∉ •[N] t := fun p hp hpt => hM p hp (Multiset.mem_add.2 (.inl hpt))
    have hpost : ∀ p ∈ S, p ∉ t •[N] := fun p hp hpt => by
      obtain ⟨q, hq, hqt⟩ := hsip t (hts t List.mem_cons_self) ⟨p, hp, hpt⟩
      exact hpre q hq hqt
    intro u hu p hp
    rcases List.mem_cons.1 hu with rfl | hu
    · exact ⟨hpre p hp, hpost p hp⟩
    · refine ih (fun u hu => hts u (List.mem_cons_of_mem _ hu)) (fun q hq hqM => ?_) u hu p hp
      rcases Multiset.mem_add.1 hqM with h | h
      · exact hM q hq (Multiset.mem_add.2 (.inr h))
      · exact hpost q hq h

/-- **Necessity** (Landweber–Robertson): a firable vector solves the state equation, and every
nonempty siphon of the subnet generated by it is marked at the initial marking. This holds in
every net. -/
theorem Firable.stateEquation_and_siphons {M₀ : Marking Place} {σ : Multiset Transition}
    (h : N.Firable M₀ σ) :
    (σ.map N.pre).sum ≤ M₀ + (σ.map N.post).sum ∧
      ∀ S, N.IsSupportSiphon σ S → S.Nonempty → MarkedOn M₀ S := by
  obtain ⟨ts, K, hts, rfl⟩ := h
  refine ⟨(mTr_add_sum_pre hts).le.trans' le_add_self, ?_⟩
  rintro S ⟨hSsub, hsip⟩ ⟨p, hp⟩
  by_contra hM
  obtain ⟨t, ht, hpt⟩ := hSsub hp
  have := unmarked_of_mTr hsip hts (fun t ht => Multiset.mem_coe.2 ht)
    (fun p hp hpM => hM ⟨p, hp, hpM⟩) t (Multiset.mem_coe.1 ht) p hp
  exact hpt.elim this.1 this.2

/-- Greedy firing inside `σ` can always continue until it is stuck: no transition that is enabled
at the end can be fired once more inside `σ`. -/
theorem exists_maximal_run (M : Marking Place) (σ : Multiset Transition) :
    ∃ us K, N.lts.MTr M us K ∧ (us : Multiset Transition) ≤ σ ∧
      ∀ t, K [t⟩[N] → ¬ t ::ₘ us ≤ σ := by
  classical
  induction σ using Multiset.strongInductionOn generalizing M with
  | ih σ ih =>
  by_cases hex : ∃ t ∈ σ, (M [t⟩[N])
  · obtain ⟨t, ht, hen⟩ := hex
    obtain ⟨M₁, h₁⟩ := enabled_iff_exists_fires.1 hen
    obtain ⟨us, K, hus, hle, hmax⟩ := ih (σ.erase t) (Multiset.erase_lt.2 ht) M₁
    refine ⟨t :: us, K, .stepL h₁ hus, ?_, fun u hu hle' => hmax u hu ?_⟩
    · rw [← Multiset.cons_coe, ← Multiset.cons_erase ht, Multiset.cons_le_cons_iff]
      exact hle
    · rw [← Multiset.cons_coe, Multiset.cons_swap] at hle'
      simpa using Multiset.erase_le_erase t hle'
  · refine ⟨[], M, .refl, Multiset.zero_le _, fun t ht hle => hex ⟨t, ?_, ht⟩⟩
    exact Multiset.mem_of_le hle (Multiset.mem_cons_self _ _)

/-- The core of sufficiency. If greedy firing inside `σ` is stuck at `K` before `σ` is exhausted,
the places that are empty at `K` and consumed by a transition of the remaining budget with the
least number of firings so far form a siphon of the subnet generated by `σ` that is unmarked at
`M₀`.

The proof counts tokens at such a place `p` with unique consumer `t`: since `p` is empty at `K`,
the tokens produced so far equal the firings of `t` so far, and since `σ` satisfies the state
equation some transition of the remaining budget produces into `p`. Minimality of `t` then rules
out any other source of tokens for `p`. -/
theorem ConflictFree.exists_unmarked_siphon (hcf : N.ConflictFree)
    (hpre : ∀ t, (•[N] t).Nodup) {M₀ K : Marking Place} {us : List Transition}
    {σ : Multiset Transition} (hus : N.lts.MTr M₀ us K) (hle : (us : Multiset Transition) ≤ σ)
    (hnn : (σ.map N.pre).sum ≤ M₀ + (σ.map N.post).sum)
    (hmax : ∀ t, K [t⟩[N] → ¬ t ::ₘ us ≤ σ) (hne : (us : Multiset Transition) ≠ σ) :
    ∃ S, N.IsSupportSiphon σ S ∧ S.Nonempty ∧ ¬ MarkedOn M₀ S := by
  classical
  set F : Multiset Transition := (us : Multiset Transition)
  have hK : ∀ p, K.count p + ((F.map N.pre).sum).count p =
      M₀.count p + ((F.map N.post).sum).count p := fun p => by
    have heq : K + (F.map N.pre).sum = M₀ + (F.map N.post).sum := mTr_add_sum_pre hus
    simpa only [Multiset.count_add] using congrArg (Multiset.count p) heq
  have hnn' : ∀ p, ((σ.map N.pre).sum).count p ≤ M₀.count p + ((σ.map N.post).sum).count p :=
    fun p => by simpa only [Multiset.count_add] using Multiset.count_le_of_le p hnn
  have hdis : ∀ t, F.count t < σ.count t → ¬ K [t⟩[N] := fun t ht hen =>
    hmax t hen <| Multiset.le_iff_count.2 fun u => by
      rw [Multiset.count_cons]
      have := Multiset.le_iff_count.1 hle u
      split_ifs with hut
      · subst hut
        omega
      · omega
  have hstarve : ∀ t, ¬ K [t⟩[N] → ∃ q, K.count q < (•[N] t).count q := fun t ht => by
    by_contra h
    simp only [not_exists, not_lt] at h
    exact ht (Multiset.le_iff_count.2 h)
  obtain ⟨t₀, ht₀, hmin⟩ := (InvImage.wf (fun t => F.count t) wellFounded_lt).has_min
    {t | F.count t < σ.count t} (by
      by_contra h
      exact hne (le_antisymm hle (Multiset.le_iff_count.2 fun u =>
        not_lt.1 fun hu => h ⟨u, hu⟩)))
  let Min : Transition → Prop := fun t =>
    F.count t < σ.count t ∧ ∀ u, F.count u < σ.count u → F.count t ≤ F.count u
  have ht₀ : Min t₀ := ⟨ht₀, fun u hu => not_lt.1 (hmin u hu)⟩
  have hC : ∀ t p, Min t → p ∈ •[N] t → K.count p < (•[N] t).count p →
      p ∉ M₀ ∧ ∀ v ∈ σ, p ∈ v •[N] → F.count v < σ.count v ∧ F.count v ≤ F.count t := by
    intro t p ⟨htR, htmin⟩ hpt hstarv
    have hp1 : (•[N] t).count p = 1 := Multiset.count_eq_one_of_mem (hpre t) hpt
    have h1 := hK p
    have h2 := hnn' p
    rw [hcf.count_sum_pre hpt, hp1] at h1 h2
    have hprod : ((σ.map N.post).sum).count p =
        ((F.map N.post).sum).count p + (((σ - F).map N.post).sum).count p := by
      rw [← Multiset.count_add, ← Multiset.sum_add, ← Multiset.map_add, add_tsub_cancel_of_le hle]
    obtain ⟨u, hru, hpu⟩ : ∃ u ∈ σ - F, p ∈ u •[N] := by
      by_contra hcon
      have : (((σ - F).map N.post).sum).count p = 0 := Multiset.count_eq_zero.2 fun hmem => by
        obtain ⟨_, hm, hpm⟩ := Multiset.mem_join.1 hmem
        obtain ⟨u, hu, rfl⟩ := Multiset.mem_map.1 hm
        exact hcon ⟨u, hu, hpm⟩
      omega
    have huR : F.count u < σ.count u := by
      have := Multiset.count_pos.2 hru
      rw [Multiset.count_sub] at this
      omega
    have hftu := htmin u huR
    have hu1 := count_le_count_sum_map hpu F
    have hM₀ : M₀.count p = 0 := by omega
    refine ⟨Multiset.count_eq_zero.1 hM₀, fun v hv hpv => ?_⟩
    have hv1 := count_le_count_sum_map hpv F
    by_cases hvR : F.count v < σ.count v
    · exact ⟨hvR, by omega⟩
    · exfalso
      have hvu : u ≠ v := fun h => hvR (h ▸ huR)
      have hfv : 0 < F.count v := by
        have := Multiset.count_pos.2 hv
        omega
      have := count_add_count_le_count_sum_map hpu hpv hvu F
      omega
  refine ⟨{p | ∃ t, Min t ∧ p ∈ •[N] t ∧ K.count p < (•[N] t).count p}, ⟨?_, ?_⟩, ?_, ?_⟩
  · rintro p ⟨t, ⟨htR, -⟩, hpt, -⟩
    exact ⟨t, Multiset.count_pos.1 (by omega), Or.inl hpt⟩
  · intro v hv ⟨p, ⟨t, htm, hpt, hst⟩, hpost⟩
    obtain ⟨hvR, hvle⟩ := (hC t p htm hpt hst).2 v hv hpost
    have hvm : Min v := ⟨hvR, fun u hu => hvle.trans (htm.2 u hu)⟩
    obtain ⟨q, hq⟩ := hstarve v (hdis v hvR)
    exact ⟨q, ⟨v, hvm, Multiset.count_pos.1 (by omega), hq⟩, Multiset.count_pos.1 (by omega)⟩
  · obtain ⟨q, hq⟩ := hstarve t₀ (hdis t₀ ht₀.1)
    exact ⟨q, t₀, ht₀, Multiset.count_pos.1 (by omega), hq⟩
  · rintro ⟨p, ⟨t, htm, hpt, hst⟩, hpos⟩
    exact (hC t p htm hpt hst).1 hpos

/-- **Landweber–Robertson** for conflict-free nets whose arcs into transitions have weight at most
one: a vector `σ` is firable at `M₀` exactly when `Σ_{t ∈ σ} pre t ≤ M₀ + Σ_{t ∈ σ} post t` and
every nonempty siphon of the subnet generated by `σ` is marked at `M₀`.

The hypothesis on the weights of `pre` is needed (`Example.weighted_not_firable`). -/
theorem ConflictFree.firable_iff (hcf : N.ConflictFree) (hpre : ∀ t, (•[N] t).Nodup)
    {M₀ : Marking Place} {σ : Multiset Transition} :
    N.Firable M₀ σ ↔ (σ.map N.pre).sum ≤ M₀ + (σ.map N.post).sum ∧
      ∀ S, N.IsSupportSiphon σ S → S.Nonempty → MarkedOn M₀ S := by
  refine ⟨Firable.stateEquation_and_siphons, fun ⟨hnn, hS⟩ => ?_⟩
  obtain ⟨us, K, hus, hle, hmax⟩ := exists_maximal_run (N := N) M₀ σ
  by_cases heq : (us : Multiset Transition) = σ
  · exact ⟨us, K, hus, heq⟩
  · obtain ⟨S, hS1, hS2, hS3⟩ := hcf.exists_unmarked_siphon hpre hus hle hnn hmax heq
    exact absurd (hS S hS1 hS2) hS3

/-- **Landweber–Robertson characterisation of reachability** in a conflict-free net whose arcs
into transitions have weight at most one: `M` is reachable from `M₀` exactly when the state
equation has a solution `σ` such that every nonempty siphon of the subnet generated by `σ` is
marked at `M₀`. -/
theorem ConflictFree.reachable_iff_siphons (hcf : N.ConflictFree)
    (hpre : ∀ t, (•[N] t).Nodup) {M₀ M : Marking Place} :
    M₀ ⇝[N] M ↔ ∃ σ : Multiset Transition,
      M + (σ.map N.pre).sum = M₀ + (σ.map N.post).sum ∧
        ∀ S, N.IsSupportSiphon σ S → S.Nonempty → MarkedOn M₀ S := by
  rw [reachable_iff_exists_firable]
  constructor
  · rintro ⟨σ, hfir, heq⟩
    exact ⟨σ, heq, (hcf.firable_iff hpre |>.1 hfir).2⟩
  · rintro ⟨σ, heq, hS⟩
    exact ⟨σ, hcf.firable_iff hpre |>.2 ⟨heq.le.trans' le_add_self, hS⟩, heq⟩

namespace Example

/-- One place and one transition that consumes two tokens and produces one. -/
def weightedNet : PetriNet Unit Unit where
  pre _ := {(), ()}
  post _ := {()}

theorem weightedNet_conflictFree : weightedNet.ConflictFree := fun _ _ _ _ _ => rfl

/-- The transition cannot fire at one token, although the state equation has a solution that
fires it once and the only siphon of the subnet it generates is marked: the weight bound on `pre`
in `ConflictFree.firable_iff` cannot be dropped. -/
theorem weighted_not_firable : ¬ weightedNet.Firable {()} {()} := by
  rintro ⟨ts, K, hts, hp⟩
  cases hts with
  | refl => exact Multiset.zero_ne_singleton _ hp
  | @stepL _ t _ _ _ htr _ =>
    cases t
    exact absurd (enabled_iff_exists_fires.2 ⟨_, htr⟩) (by decide)

theorem weighted_stateEquation :
    (({()} : Multiset Unit).map weightedNet.pre).sum ≤
      {()} + (({()} : Multiset Unit).map weightedNet.post).sum := by
  decide

theorem weighted_siphons : ∀ S, weightedNet.IsSupportSiphon {()} S →
    S.Nonempty → MarkedOn ({()} : Marking Unit) S := by
  rintro S - ⟨p, hp⟩
  exact ⟨p, hp, Multiset.mem_singleton_self _⟩

end Example

end LandweberRobertson

end PetriNet

end Cslib
