module

public import Cslib.Computability.PetriNets.StateEquation
public import Cslib.Computability.PetriNets.Structure

/-! # Conflict-free nets

A net is *conflict-free* if every place is an input of at most one transition (Landweber and
Robertson). Then no two distinct transitions compete for tokens, so firing one transition never
disables another: conflict-free nets are *persistent*. (Landweber and Robertson also allow a place
shared by several transitions when it lies on a self-loop with each of them; we use the simpler
structural condition.)

## Main definitions

- `PetriNet.ConflictFree`: every place has at most one consumer transition.
- `PetriNet.Firable`: a firing count vector is the Parikh vector of a firing sequence from `M`.

## Main statements

- `PetriNet.ConflictFree.enabled_fires`: persistence.
- `PetriNet.ConflictFree.diamond`: two enabled distinct transitions commute.
- `PetriNet.ConflictFree.exists_mTr_of_le`: a firing sequence whose firing counts stay below
  those of a firing sequence `ts` can be completed to realise the firing count vector of `ts`
  (and reaches the same marking).
- `PetriNet.ConflictFree.parikh_eq_of_maximal`: a firing sequence inside `σ` that cannot be
  extended inside `σ` realises `σ`, if `σ` is firable at all. So firing greedily inside `σ` never
  needs to backtrack.
- `PetriNet.Firable.stateEquation_and_siphons`: necessity of the siphon condition.
- `PetriNet.ConflictFree.firable_iff`, `PetriNet.ConflictFree.reachable_iff_siphons`: the
  Landweber–Robertson characterisation, when arcs into transitions have weight at most one.
- `PetriNet.reachable_iff_exists_firable`: reachability is firability of a solution of the state
  equation.

## Landweber–Robertson

In a conflict-free net whose arcs into transitions have weight at most one, a vector `σ` is firable
at `M₀` iff `M₀ + C σ ≥ 0` and every nonempty siphon of the subnet generated by the support of
`σ` (the transitions of `supp σ` and the places they touch) is marked at `M₀`. The weight bound
is necessary: with one place and a transition consuming two tokens and producing one,
`σ = 1` solves the state equation at one token and the siphon is marked, but nothing fires
(`Example.weighted_not_firable`). The sufficiency proof takes a greedy sequence inside `σ` that
is stuck, and shows that the empty input places of the remaining transition(s) with fewest firings
so far form an unmarked siphon (`ConflictFree.exists_unmarked_siphon`). Arbitrary weights on `post`
are allowed.

## References

* [L. H. Landweber and E. L. Robertson, *Properties of conflict-free and persistent Petri
  nets*][LandweberRobertson1978]
-/

@[expose] public section

namespace Cslib

namespace PetriNet

open scoped PetriNet

variable {Place : Type*} {Transition : Type*}

/-- A net is conflict-free if every place is an input of at most one transition. -/
def ConflictFree (N : PetriNet Place Transition) : Prop :=
  ∀ t u p, 0 < N.pre t p → 0 < N.pre u p → t = u

namespace ConflictFree

variable {N : PetriNet Place Transition}

/-- Persistence: in a conflict-free net, firing a transition never disables another one. -/
theorem enabled_fires (hcf : N.ConflictFree) {M M' : Marking Place} {t u : Transition}
    (ht : M [t⟩[N]) (hu : M [u⟩[N] M') (hne : t ≠ u) : M' [t⟩[N] := by
  obtain ⟨R, rfl, rfl⟩ := hu
  intro p
  have h := ht p
  rw [Finsupp.add_apply] at h ⊢
  by_cases hp : 0 < N.pre u p
  · have : N.pre t p = 0 := by
      by_contra h0
      exact hne (hcf t u p (Nat.pos_of_ne_zero h0) hp)
    omega
  · have : N.pre u p = 0 := by omega
    omega

/-- Two distinct transitions that are enabled at a marking can be fired in either order, with the
same result. -/
theorem diamond (hcf : N.ConflictFree) {M M₁ M₂ : Marking Place} {t u : Transition}
    (h₁ : M [t⟩[N] M₁) (h₂ : M [u⟩[N] M₂) (hne : t ≠ u) :
    ∃ M₃, M₁ [u⟩[N] M₃ ∧ M₂ [t⟩[N] M₃ := by
  have e₁ := (fires_iff.1 h₁).1
  have e₂ := (fires_iff.1 h₂).1
  obtain ⟨M₃, h₃⟩ := enabled_iff_exists_fires.1 (hcf.enabled_fires e₂ h₁ hne.symm)
  obtain ⟨M₄, h₄⟩ := enabled_iff_exists_fires.1 (hcf.enabled_fires e₁ h₂ hne)
  have : M₃ = M₄ := by
    apply Marking.toInt_injective
    rw [h₃.toInt, h₁.toInt, h₄.toInt, h₂.toInt]
    abel
  exact ⟨M₃, h₃, this ▸ h₄⟩

/-- A transition occurring in a firing sequence and enabled at its start can be moved to the
front. -/
theorem slide (hcf : N.ConflictFree) {M M₁ M' : Marking Place} {u : Transition}
    {ts : List Transition} (hts : N.lts.MTr M ts M') (hu : M [u⟩[N] M₁) (hmem : u ∈ ts) :
    ∃ ts', N.lts.MTr M₁ ts' M' ∧ parikh ts = Finsupp.single u 1 + parikh ts' := by
  induction hts generalizing M₁ with
  | refl => simp at hmem
  | @stepL M t M₂ ts M' htr hrest ih =>
    by_cases htu : t = u
    · subst htu
      have : M₂ = M₁ := LTS.Deterministic.deterministic (lts := N.lts) _ _ _ _ htr hu
      subst this
      exact ⟨ts, hrest, by simp⟩
    · have hmem' : u ∈ ts := by simpa [Ne.symm htu] using hmem
      obtain ⟨M₃, h₃, h₄⟩ := hcf.diamond htr hu htu
      obtain ⟨ts', h', hp⟩ := ih h₃ hmem'
      refine ⟨t :: ts', .stepL h₄ h', ?_⟩
      rw [parikh_cons, parikh_cons, hp]
      abel

/-- The completion theorem: if `ts` fires from `M` and `us` fires from `M` using each transition at
most as often as `ts`, then `us` can be completed to a firing sequence with the firing count
vector of `ts`, reaching the same marking as `ts`. -/
theorem exists_mTr_of_le (hcf : N.ConflictFree) {M K M' : Marking Place} {ts us : List Transition}
    (hts : N.lts.MTr M ts M') (hus : N.lts.MTr M us K) (hle : parikh us ≤ parikh ts) :
    ∃ vs, N.lts.MTr K vs M' ∧ parikh us + parikh vs = parikh ts := by
  induction hus generalizing ts with
  | refl => exact ⟨ts, hts, by simp⟩
  | @stepL M u M₁ us K htr hrest ih =>
    have hpos : 0 < parikh ts u := by
      have h1 : 0 < parikh (u :: us) u := by simp [parikh_cons]
      exact lt_of_lt_of_le h1 (by simpa [parikh_cons] using hle u)
    obtain ⟨ts', hts', hp⟩ := hcf.slide hts htr (parikh_pos_iff.1 hpos)
    have hle' : parikh us ≤ parikh ts' := by
      intro t
      have := hle t
      simp only [parikh_cons, hp, Finsupp.add_apply] at this
      omega
    obtain ⟨vs, hvs, hvp⟩ := ih hts' hle'
    refine ⟨vs, hvs, ?_⟩
    rw [parikh_cons, hp, ← hvp]
    abel

end ConflictFree

/-- A firing count vector `σ` is firable at `M` if some firing sequence from `M` has it as firing
count vector. -/
def Firable (N : PetriNet Place Transition) (M : Marking Place) (σ : Transition →₀ ℕ) : Prop :=
  ∃ ts K, N.lts.MTr M ts K ∧ parikh ts = σ

namespace ConflictFree

variable {N : PetriNet Place Transition}

/-- Greedy firing inside a firable vector `σ` cannot get stuck: a firing sequence inside `σ` that
cannot be extended inside `σ` has firing count vector `σ`. -/
theorem parikh_eq_of_maximal (hcf : N.ConflictFree) {M K : Marking Place} {σ : Transition →₀ ℕ}
    {us : List Transition} (hσ : N.Firable M σ) (hus : N.lts.MTr M us K)
    (hle : parikh us ≤ σ) (hmax : ∀ t, K [t⟩[N] → σ t ≤ parikh us t) : parikh us = σ := by
  obtain ⟨ts, M', hts, rfl⟩ := hσ
  obtain ⟨vs, hvs, hp⟩ := hcf.exists_mTr_of_le hts hus hle
  cases hvs with
  | refl => simpa using hp
  | @stepL _ t K₁ vs _ htr _ =>
    have := hmax t (fires_iff.1 htr).1
    have := congrArg (· t) hp
    simp [parikh_cons] at this
    omega

end ConflictFree

/-- Reachability is firability of a solution of the state equation. -/
theorem reachable_iff_exists_firable {N : PetriNet Place Transition} {M M' : Marking Place} :
    M ⇝[N] M' ↔ ∃ σ, N.Firable M σ ∧ Marking.toInt M' = Marking.toInt M + N.vectorEffect σ := by
  constructor
  · rintro ⟨ts, hts⟩
    exact ⟨parikh ts, ⟨ts, M', hts, rfl⟩, by rw [mTr_toInt hts, effect_eq_vectorEffect]⟩
  · rintro ⟨σ, ⟨ts, K, hts, rfl⟩, h⟩
    have : M' = K := by
      apply Marking.toInt_injective
      rw [h, mTr_toInt hts, effect_eq_vectorEffect]
    exact this ▸ ⟨ts, hts⟩

section LandweberRobertson

variable {N : PetriNet Place Transition}

/-- The places touched by the transitions of the support of `σ`: the places of the subnet
generated by `supp σ`. -/
def supportPlaces (N : PetriNet Place Transition) (σ : Transition →₀ ℕ) : Set Place :=
  {p | ∃ t ∈ σ.support, 0 < N.pre t p ∨ 0 < N.post t p}

/-- A siphon of the subnet generated by the support of `σ`: a set of places of that subnet such
that every transition of the support that produces into the set also consumes from it. -/
def IsSupportSiphon (N : PetriNet Place Transition) (σ : Transition →₀ ℕ) (S : Set Place) :
    Prop :=
  S ⊆ N.supportPlaces σ ∧
    ∀ t ∈ σ.support, (∃ p ∈ S, 0 < N.post t p) → ∃ q ∈ S, 0 < N.pre t q

/-- In a conflict-free net, the only consumer of `p` is `t`, so a firing count vector `σ` takes
`σ t * pre t p` tokens from `p`. -/
theorem ConflictFree.consumed_eq (hcf : N.ConflictFree) {t : Transition} {p : Place}
    (hp : 0 < N.pre t p) (σ : Transition →₀ ℕ) : N.consumed σ p = σ t * N.pre t p := by
  rw [consumed_apply, Finsupp.sum_eq_single t]
  · intro u _ hut
    have : N.pre u p = 0 := by
      by_contra h
      exact hut (hcf u t p (Nat.pos_of_ne_zero h) hp)
    simp [this]
  · simp

theorem pair_le_produced (σ : Transition →₀ ℕ) (p : Place) {u v : Transition} (huv : u ≠ v) :
    σ u * N.post u p + σ v * N.post v p ≤ N.produced σ p := by
  classical
  rw [produced_apply, Finsupp.sum_of_support_subset σ (Finset.subset_union_left (s₂ := {u, v})) _
    (by simp), ← Finset.sum_pair (f := fun u => σ u * N.post u p) huv]
  exact Finset.sum_le_sum_of_subset Finset.subset_union_right

/-- A siphon of the support subnet that is unmarked stays unmarked along a firing sequence of the
support, and no transition of the sequence touches it. -/
theorem unmarked_of_mTr {M K : Marking Place} {ts : List Transition} {σ : Transition →₀ ℕ}
    {S : Set Place} (hsip : ∀ t ∈ σ.support, (∃ p ∈ S, 0 < N.post t p) → ∃ q ∈ S, 0 < N.pre t q)
    (h : N.lts.MTr M ts K) (hts : ∀ t ∈ ts, t ∈ σ.support) (hM : ∀ p ∈ S, M p = 0) :
    ∀ t ∈ ts, ∀ p ∈ S, N.pre t p = 0 ∧ N.post t p = 0 := by
  induction h with
  | refl => simp
  | @stepL M t M₁ ts K htr _ ih =>
    obtain ⟨hen, rfl⟩ := fires_iff.1 htr
    have hpre : ∀ p ∈ S, N.pre t p = 0 := fun p hp => by have := hen p; have := hM p hp; omega
    have hpost : ∀ p ∈ S, N.post t p = 0 := fun p hp => by
      by_contra h0
      obtain ⟨q, hq, hqpos⟩ := hsip t (hts t (by simp)) ⟨p, hp, Nat.pos_of_ne_zero h0⟩
      have := hpre q hq
      omega
    intro u hu p hp
    rcases List.mem_cons.1 hu with rfl | hu
    · exact ⟨hpre p hp, hpost p hp⟩
    · exact ih (fun u hu => hts u (List.mem_cons_of_mem _ hu))
        (fun q hq => by simp [fire, hpre q hq, hpost q hq, hM q hq]) u hu p hp

/-- **Necessity** (Landweber–Robertson): a firable vector solves the state equation, and every
nonempty siphon of the subnet generated by its support is marked at the initial marking. This
holds in every net. -/
theorem Firable.stateEquation_and_siphons {M₀ : Marking Place} {σ : Transition →₀ ℕ}
    (h : N.Firable M₀ σ) :
    (∀ p, 0 ≤ (M₀ p : ℤ) + N.vectorEffect σ p) ∧
      ∀ S, N.IsSupportSiphon σ S → S.Nonempty → MarkedOn M₀ S := by
  obtain ⟨ts, K, hts, rfl⟩ := h
  constructor
  · intro p
    have := congrArg (fun K => K p) (mTr_toInt hts)
    simp only [Finsupp.add_apply, Marking.toInt_apply, effect_eq_vectorEffect] at this
    omega
  · intro S ⟨hSsub, hsip⟩ ⟨p, hp⟩
    by_contra hM
    replace hM : ∀ p ∈ S, M₀ p = 0 := fun p hp => by
      by_contra h0
      exact hM ⟨p, hp, Nat.pos_of_ne_zero h0⟩
    have hmem : ∀ t ∈ ts, t ∈ (parikh ts).support := fun t ht =>
      Finsupp.mem_support_iff.2 (parikh_pos_iff.2 ht).ne'
    obtain ⟨t, ht, hpt⟩ := hSsub hp
    have htts : t ∈ ts := parikh_pos_iff.1 (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 ht))
    have := unmarked_of_mTr hsip hts hmem hM t htts p hp
    omega

/-- Greedy firing inside `σ` can always continue until it is stuck: every transition that is enabled
at the end has already been fired as often as `σ` allows. -/
theorem exists_maximal_run (M : Marking Place) (σ : Transition →₀ ℕ) :
    ∃ us K, N.lts.MTr M us K ∧ parikh us ≤ σ ∧ ∀ t, K [t⟩[N] → σ t ≤ parikh us t := by
  induction h : σ.degree using Nat.strong_induction_on generalizing M σ with
  | _ n ih =>
  by_cases hex : ∃ t, M [t⟩[N] ∧ Finsupp.single t 1 ≤ σ
  · obtain ⟨t, hen, hle⟩ := hex
    have hσt : σ t ≠ 0 := by have := Finsupp.single_le_iff.1 hle; omega
    obtain ⟨us, K, hus, hle', hmax⟩ := ih _ (by have := degree_tsub_single_add_one hσt; omega)
      (N.fire M t) (σ - Finsupp.single t 1) rfl
    refine ⟨t :: us, K, .stepL (fires_iff.2 ⟨hen, rfl⟩) hus, ?_, fun u hu => ?_⟩
    · rw [parikh_cons]
      calc Finsupp.single t 1 + parikh us ≤ Finsupp.single t 1 + (σ - Finsupp.single t 1) := by
            gcongr
        _ = σ := add_tsub_cancel_of_le hle
    · have := hmax u hu
      by_cases hut : u = t <;> simp [parikh_cons, hut] at this ⊢ <;> omega
  · exact ⟨[], M, .refl, by simp, fun t ht => not_lt.1 fun hlt =>
      hex ⟨t, ht, Finsupp.single_le_iff.2 (by simp at hlt; omega)⟩⟩

/-- The core of sufficiency. If greedy firing inside `σ` is stuck at `K` before `σ` is exhausted,
the places that are empty at `K` and consumed by a transition of the remaining budget with the
least number of firings so far form a siphon of the support subnet that is unmarked at `M₀`.

The proof counts tokens at such a place `p` with unique consumer `t`: since `K p = 0`, the tokens
produced so far equal the firings of `t` so far, and since `M₀ + C σ ≥ 0` some transition of the
remaining budget produces into `p`. Minimality of `t` then rules out any other source of tokens
for `p`. -/
theorem ConflictFree.exists_unmarked_siphon (hcf : N.ConflictFree)
    (hpre : ∀ t p, N.pre t p ≤ 1) {M₀ K : Marking Place} {us : List Transition}
    {σ : Transition →₀ ℕ} (hus : N.lts.MTr M₀ us K) (hle : parikh us ≤ σ)
    (hnn : ∀ p, 0 ≤ (M₀ p : ℤ) + N.vectorEffect σ p)
    (hmax : ∀ t, K [t⟩[N] → σ t ≤ parikh us t) (hne : parikh us ≠ σ) :
    ∃ S, N.IsSupportSiphon σ S ∧ S.Nonempty ∧ ¬ MarkedOn M₀ S := by
  classical
  set f := parikh us with hf
  have hK : ∀ p, K p + N.consumed f p = M₀ p + N.produced f p := by
    refine toInt_eq_add_vectorEffect_iff.1 ?_
    rw [mTr_toInt hus, effect_eq_vectorEffect]
  have hnn' : ∀ p, N.consumed σ p ≤ M₀ p + N.produced σ p := fun p => by
    have := hnn p
    rw [vectorEffect_apply_eq_sub] at this
    omega
  have hdis : ∀ t, f t < σ t → ¬ K [t⟩[N] := fun t ht hen => (hmax t hen).not_gt ht
  have hstarve : ∀ t, ¬ K [t⟩[N] → ∃ q, K q < N.pre t q := fun t ht => by
    simpa [Enabled, Finsupp.le_def] using ht
  obtain ⟨t₀, ht₀, hmin⟩ := (InvImage.wf f wellFounded_lt).has_min {t | f t < σ t} (by
    by_contra h
    exact hne (le_antisymm hle fun u => not_lt.1 fun hu => h ⟨u, hu⟩))
  let Min : Transition → Prop := fun t => f t < σ t ∧ ∀ u, f u < σ u → f t ≤ f u
  have ht₀ : Min t₀ := ⟨ht₀, fun u hu => not_lt.1 (hmin u hu)⟩
  have hC : ∀ t p, Min t → 0 < N.pre t p → K p < N.pre t p →
      M₀ p = 0 ∧ ∀ v, 0 < σ v → 0 < N.post v p → f v < σ v ∧ f v ≤ f t := by
    intro t p ⟨htR, htmin⟩ hpre0 hstarv
    have hp1 : N.pre t p = 1 := le_antisymm (hpre t p) hpre0
    have h1 := hK p
    have h2 := hnn' p
    rw [hcf.consumed_eq hpre0, hp1] at h1 h2
    have hprod : N.produced σ p = N.produced f p + N.produced (σ - f) p := by
      rw [← Finsupp.add_apply, ← produced_add, add_tsub_cancel_of_le hle]
    obtain ⟨u, hru, hpu⟩ : ∃ u, 0 < (σ - f) u ∧ 0 < N.post u p := by
      by_contra hcon
      push Not at hcon
      have : N.produced (σ - f) p = 0 := by
        rw [produced_apply]
        exact Finset.sum_eq_zero fun u _ => (Nat.eq_zero_or_pos ((σ - f) u)).elim (by simp [·])
          fun h => by simp [Nat.le_zero.1 (hcon u h)]
      omega
    have huR : f u < σ u := by
      rw [Finsupp.tsub_apply] at hru
      omega
    have hftu := htmin u huR
    have hu1 : f u ≤ N.produced f p :=
      (Nat.le_mul_of_pos_right _ hpu).trans (mul_post_le_produced f u p)
    have hM₀ : M₀ p = 0 := by omega
    refine ⟨hM₀, fun v hσv hpv => ?_⟩
    have hv1 : f v ≤ f v * N.post v p := Nat.le_mul_of_pos_right _ hpv
    by_cases hvR : f v < σ v
    · exact ⟨hvR, by have := mul_post_le_produced (N := N) f v p; omega⟩
    · exfalso
      have hvu : u ≠ v := fun h => hvR (h ▸ huR)
      have hfv : 0 < f v := by have := hle v; omega
      have hpair := pair_le_produced f p (N := N) hvu
      have hu2 : f u ≤ f u * N.post u p := Nat.le_mul_of_pos_right _ hpu
      omega
  refine ⟨{p | ∃ t, Min t ∧ 0 < N.pre t p ∧ K p < N.pre t p}, ⟨?_, ?_⟩, ?_, ?_⟩
  · rintro p ⟨t, ⟨htR, -⟩, hpt, -⟩
    exact ⟨t, Finsupp.mem_support_iff.2 (by omega), Or.inl hpt⟩
  · intro v hv ⟨p, ⟨t, htm, hpt, hst⟩, hpost⟩
    obtain ⟨hvR, hvle⟩ := (hC t p htm hpt hst).2 v
      (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hv)) hpost
    have hvm : Min v := ⟨hvR, fun u hu => hvle.trans (htm.2 u hu)⟩
    obtain ⟨q, hq⟩ := hstarve v (hdis v hvR)
    exact ⟨q, ⟨v, hvm, by omega, hq⟩, by omega⟩
  · obtain ⟨q, hq⟩ := hstarve t₀ (hdis t₀ ht₀.1)
    exact ⟨q, t₀, ht₀, by omega, hq⟩
  · rintro ⟨p, ⟨t, htm, hpt, hst⟩, hpos⟩
    have := (hC t p htm hpt hst).1
    omega

/-- **Landweber–Robertson** for conflict-free nets whose arcs into transitions have weight at most
one: a vector `σ` is firable at `M₀` exactly when `M₀ + C σ ≥ 0` and every nonempty siphon of
the subnet generated by the support of `σ` is marked at `M₀`.

The hypothesis on the weights of `pre` is needed (`Example.weighted_not_firable`). -/
theorem ConflictFree.firable_iff (hcf : N.ConflictFree) (hpre : ∀ t p, N.pre t p ≤ 1)
    {M₀ : Marking Place} {σ : Transition →₀ ℕ} :
    N.Firable M₀ σ ↔ (∀ p, 0 ≤ (M₀ p : ℤ) + N.vectorEffect σ p) ∧
      ∀ S, N.IsSupportSiphon σ S → S.Nonempty → MarkedOn M₀ S := by
  refine ⟨Firable.stateEquation_and_siphons, fun ⟨hnn, hS⟩ => ?_⟩
  obtain ⟨us, K, hus, hle, hmax⟩ := exists_maximal_run (N := N) M₀ σ
  by_cases heq : parikh us = σ
  · exact ⟨us, K, hus, heq⟩
  · obtain ⟨S, hS1, hS2, hS3⟩ := hcf.exists_unmarked_siphon hpre hus hle hnn hmax heq
    exact absurd (hS S hS1 hS2) hS3

/-- **Landweber–Robertson characterisation of reachability** in a conflict-free net whose arcs
into transitions have weight at most one: `M` is reachable from `M₀` exactly when the state
equation has a nonnegative solution `σ` such that every nonempty siphon of the subnet generated by
the support of `σ` is marked at `M₀`. -/
theorem ConflictFree.reachable_iff_siphons (hcf : N.ConflictFree)
    (hpre : ∀ t p, N.pre t p ≤ 1) {M₀ M : Marking Place} :
    M₀ ⇝[N] M ↔ ∃ σ : Transition →₀ ℕ,
      Marking.toInt M = Marking.toInt M₀ + N.vectorEffect σ ∧
        ∀ S, N.IsSupportSiphon σ S → S.Nonempty → MarkedOn M₀ S := by
  rw [reachable_iff_exists_firable]
  constructor
  · rintro ⟨σ, hfir, heq⟩
    exact ⟨σ, heq, (hcf.firable_iff hpre |>.1 hfir).2⟩
  · rintro ⟨σ, heq, hS⟩
    refine ⟨σ, hcf.firable_iff hpre |>.2 ⟨fun p => ?_, hS⟩, heq⟩
    have := congrArg (fun K => K p) heq
    simp only [Finsupp.add_apply, Marking.toInt_apply] at this
    omega

namespace Example

/-- One place and one transition that consumes two tokens and produces one. -/
noncomputable def weightedNet : PetriNet Unit Unit where
  pre _ := Finsupp.single () 2
  post _ := Finsupp.single () 1

theorem weightedNet_conflictFree : weightedNet.ConflictFree := fun _ _ _ _ _ => rfl

/-- The transition cannot fire at one token, although the state equation has a solution that
fires it once and the only siphon of its support subnet is marked: the weight bound on `pre` in
`ConflictFree.firable_iff` cannot be dropped. -/
theorem weighted_not_firable :
    ¬ weightedNet.Firable (Finsupp.single () 1) (Finsupp.single () 1) := by
  rintro ⟨ts, K, hts, hp⟩
  cases hts with
  | refl => simpa using congrArg (· ()) hp
  | stepL htr _ =>
    have := (fires_iff.1 htr).1 ()
    simp [weightedNet] at this

theorem weighted_stateEquation :
    ∀ p, 0 ≤ ((Finsupp.single () 1 : Marking Unit) p : ℤ) +
      weightedNet.vectorEffect (Finsupp.single () 1) p := by
  intro p
  simp [weightedNet, incidence]

theorem weighted_siphons : ∀ S, weightedNet.IsSupportSiphon (Finsupp.single () 1) S →
    S.Nonempty → MarkedOn (Finsupp.single () 1 : Marking Unit) S := by
  rintro S - ⟨p, hp⟩
  exact ⟨p, hp, by cases p; simp⟩

end Example

end LandweberRobertson

end PetriNet

end Cslib
