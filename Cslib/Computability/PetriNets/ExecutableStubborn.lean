module

public import Cslib.Computability.PetriNets.ExecutableReachability
public import Cslib.Computability.PetriNets.StubbornSets

/-! # A computable stubborn selector

For an executable net with finitely many transitions, the stubborn set generated by a transition is
computed by iterating a one-step function on finite sets of transitions, as many times as there are
transitions. A transition brings in the transitions that conflict with it (`PetriNet.Conflict`) if
it is enabled, and the transitions that add tokens to its least missing place if it is disabled.
The stubborn set at a marking is the one generated by the enabled transition for which the
generated set contains the fewest enabled transitions, and the least such transition. All choices
need a linear order on transitions and places.

## Main definitions

- `ExecPetriNet.stubbornFinset`: the computed stubborn set at a marking.
- `ExecPetriNet.finsetSelector`: the selector for `PetriNet.reduced` given by a computed set at
  each marking, and `ExecPetriNet.stubbornSelector` for the computed stubborn sets.
- `ExecPetriNet.reducedReachSet`: the markings reachable in at most `n` steps of the graph reduced
  by a computed selector, as a finite set, and `ExecPetriNet.ReducedClosed` says that it is closed.

## Main statements

- `ExecPetriNet.stubbornFinset_closed`: the computed set is `PetriNet.StubbornClosed`, hence
  stubborn.
- `ExecPetriNet.exists_enabled_mem_stubbornFinset`: at a non-dead marking, it contains an enabled
  transition.
- `ExecPetriNet.canReach_dead_iff_reduced`: a dead marking is reachable iff it is reachable in the
  graph reduced by the computed selector.
- `ExecPetriNet.reducedReachSet_subset`: the computed reduced reachable markings are reachable.
-/

@[expose] public section

namespace Cslib

namespace ExecPetriNet

open PetriNet
open scoped PetriNet

section Iterate

/-- An inflationary self-map of the finite sets of a finite type is stable after as many
iterations as there are elements. -/
theorem iterate_card_fixed {α : Type*} [Fintype α] (f : Finset α → Finset α)
    (hf : ∀ s, s ⊆ f s) (x : Finset α) : f (f^[Fintype.card α] x) = f^[Fintype.card α] x := by
  by_contra hne
  have hstrict : ∀ k ≤ Fintype.card α, f^[k] x ⊂ f (f^[k] x) := by
    intro k hk
    refine (hf _).ssubset_of_ne fun h => hne ?_
    have hfix : f (f^[k] x) = f^[k] x := h.symm
    have : f^[Fintype.card α] x = f^[k] x := by
      obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le hk
      rw [hm, add_comm, Function.iterate_add_apply, Function.iterate_fixed hfix m]
    rw [this]
    exact hfix
  have hcard : ∀ k ≤ Fintype.card α + 1, k ≤ (f^[k] x).card := by
    intro k
    induction k with
    | zero => intro; exact Nat.zero_le _
    | succ k ih =>
      intro hk
      rw [Function.iterate_succ_apply']
      have := Finset.card_lt_card (hstrict k (by omega))
      have := ih (by omega)
      omega
  have := hcard (Fintype.card α + 1) le_rfl
  have := Finset.card_le_univ (f^[Fintype.card α + 1] x)
  omega

end Iterate

variable {Place Transition : Type*} [LinearOrder Place] (N : ExecPetriNet Place Transition)

/-- The least place where the marking `M` has fewer tokens than the preset of `t` requires, if
there is one. -/
def missingPlace (M : Multiset Place) (t : Transition) : Option Place :=
  let s := (N.pre t).toFinset.filter fun p => M.count p < (N.pre t).count p
  if h : s.Nonempty then some (s.min' h) else none

/-- A disabled transition has a missing place, and `missingPlace` finds one. -/
theorem exists_missingPlace {M : Multiset Place} {t : Transition} (h : ¬ N.pre t ≤ M) :
    ∃ p, N.missingPlace M t = some p ∧ M.count p < (N.pre t).count p := by
  obtain ⟨q, hq⟩ : ∃ q, M.count q < (N.pre t).count q := by
    by_contra hc
    push Not at hc
    exact h (Multiset.le_iff_count.2 hc)
  set s := (N.pre t).toFinset.filter fun p => M.count p < (N.pre t).count p with hs
  have hne : s.Nonempty :=
    ⟨q, Finset.mem_filter.2 ⟨Multiset.mem_toFinset.2 (Multiset.count_pos.1 (by omega)), hq⟩⟩
  have hne' : ((N.pre t).toFinset.filter fun p => M.count p < (N.pre t).count p).Nonempty := hne
  exact ⟨s.min' hne, by simp [missingPlace, hs, hne'], (Finset.mem_filter.1 (s.min'_mem hne)).2⟩

section Selector

variable (sel : Multiset Place → Finset Transition)

/-- The selector of `PetriNet.reduced` given by a finite set of transitions for each marking, which
is read as a multiset. -/
noncomputable def finsetSelector (sel : Multiset Place → Finset Transition) (M : Marking Place) :
    Set Transition :=
  sel (Multiset.toFinsupp.symm M)

@[simp]
theorem finsetSelector_toFinsupp (M : Multiset Place) :
    finsetSelector sel (Multiset.toFinsupp M) = sel M := by
  simp [finsetSelector]

end Selector

section Reduced

variable (sel : Multiset Place → Finset Transition)

/-- The markings reached by one more firing of a transition selected by `sel`, from some marking
in `S`. -/
def reducedStepSet (S : Finset (Multiset Place)) : Finset (Multiset Place) :=
  S.biUnion fun M => (sel M).biUnion fun t => (N.fire M t).toFinset

/-- The markings reachable from `M₀` in at most `n` steps of the graph reduced by `sel`. -/
def reducedReachSet (M₀ : Multiset Place) : ℕ → Finset (Multiset Place)
  | 0 => {M₀}
  | n + 1 => reducedReachSet M₀ n ∪ N.reducedStepSet sel (reducedReachSet M₀ n)

/-- The level `n` of `reducedReachSet` is closed: it contains the markings reached by one more
selected firing. -/
def ReducedClosed (M₀ : Multiset Place) (n : ℕ) : Prop :=
  N.reducedStepSet sel (N.reducedReachSet sel M₀ n) ⊆ N.reducedReachSet sel M₀ n

instance (M₀ : Multiset Place) (n : ℕ) : Decidable (N.ReducedClosed sel M₀ n) :=
  by unfold ReducedClosed; infer_instance

variable {N sel}

theorem mem_reducedReachSet_self {M₀ : Multiset Place} (n : ℕ) :
    M₀ ∈ N.reducedReachSet sel M₀ n := by
  induction n with
  | zero => exact Finset.mem_singleton_self _
  | succ n ih => exact Finset.mem_union_left _ ih

/-- A step of the reduced graph from a marking in a closed set stays in it. -/
theorem mem_of_reduced_mTr {S : Finset (Multiset Place)} (hS : N.reducedStepSet sel S ⊆ S)
    {M M' : Marking Place} {ρ : List Transition}
    (h : (N.toPetriNet.reduced (finsetSelector sel)).MTr M ρ M') :
    ∀ m ∈ S, M = Multiset.toFinsupp m → ∃ m' ∈ S, M' = Multiset.toFinsupp m' := by
  induction h with
  | refl => exact fun m hm h => ⟨m, hm, h⟩
  | @stepL M₁ μ M₂ ρ M₃ htr _ ih =>
    intro m hm rfl
    obtain ⟨hμ, hf⟩ := htr
    obtain ⟨m₂, rfl, hf₂⟩ := (fires_toFinsupp_iff N).1 hf
    rw [finsetSelector_toFinsupp] at hμ
    refine ih m₂ (hS ?_) rfl
    simp only [reducedStepSet, Finset.mem_biUnion, Option.mem_toFinset]
    exact ⟨m, hm, μ, by simpa using hμ, hf₂⟩

/-- Every marking in `reducedReachSet` is reachable in the reduced graph. -/
theorem reducedReachSet_reachable {M₀ M : Multiset Place} {n : ℕ}
    (h : M ∈ N.reducedReachSet sel M₀ n) :
    (N.toPetriNet.reduced (finsetSelector sel)).CanReach (Multiset.toFinsupp M₀)
      (Multiset.toFinsupp M) := by
  induction n generalizing M with
  | zero =>
    rw [reducedReachSet, Finset.mem_singleton] at h
    subst h
    exact LTS.CanReach.refl _ _
  | succ n ih =>
    rcases Finset.mem_union.1 h with h | h
    · exact ih h
    · simp only [reducedStepSet, Finset.mem_biUnion, Option.mem_toFinset] at h
      obtain ⟨M', hM', t, ht, hf⟩ := h
      obtain ⟨σ, hσ⟩ := ih hM'
      refine ⟨σ ++ [t], hσ.comp _ (.single _ ⟨?_, fires_iff.2 hf⟩)⟩
      simpa using ht

/-- The computed reduced reachable markings are reachable markings of the net. -/
theorem reducedReachSet_subset {M₀ M : Multiset Place} {n : ℕ}
    (h : M ∈ N.reducedReachSet sel M₀ n) : M₀ ⇝[N] M :=
  let ⟨ρ, hρ⟩ := reducedReachSet_reachable h
  ⟨ρ, hρ.of_reduced⟩

end Reduced

section Computed

variable [LinearOrder Transition] [Fintype Transition]

/-- Whether `t` and `u` are in conflict (`PetriNet.Conflict`). -/
def conflicts (t u : Transition) : Bool :=
  decide (∃ p ∈ (N.pre t).toFinset, 0 < (N.pre u).count p ∧
    ((N.post t).count p < (N.pre t).count p ∨ (N.post u).count p < (N.pre u).count p))

/-- Whether `u` is brought in by `t` in the stubborn closure at `M`: if `t` is enabled, by being
in conflict with it, and if `t` is disabled, by adding tokens to its missing place. -/
def stubbornRel (M : Multiset Place) (t u : Transition) : Bool :=
  if N.pre t ≤ M then N.conflicts t u
  else match N.missingPlace M t with
    | some p => decide ((N.pre u).count p < (N.post u).count p)
    | none => false

/-- One step of the closure: add the transitions brought in by the members. -/
def stubbornStep (M : Multiset Place) (T : Finset Transition) : Finset Transition :=
  T ∪ Finset.univ.filter fun u => ∃ t ∈ T, N.stubbornRel M t u = true

/-- The stubborn set generated by `t` at `M`. -/
def closure (M : Multiset Place) (t : Transition) : Finset Transition :=
  (N.stubbornStep M)^[Fintype.card Transition] {t}

/-- The number of enabled transitions in the set generated by `t` at `M`. -/
def cost (M : Multiset Place) (t : Transition) : ℕ :=
  ((N.closure M t).filter fun u => N.pre u ≤ M).card

/-- The enabled transition with the cheapest generated set, and the least such transition, if
there is an enabled transition. -/
def seed (M : Multiset Place) : Option Transition :=
  let s := Finset.univ.filter fun t => N.pre t ≤ M
  if h : s.Nonempty then
    some (ofLex ((s.image fun t => toLex (N.cost M t, t)).min' (h.image _))).2
  else none

/-- The stubborn set at `M`, which is empty at dead markings. -/
def stubbornFinset (M : Multiset Place) : Finset Transition :=
  match N.seed M with
  | none => ∅
  | some t => N.closure M t

theorem subset_stubbornStep (M : Multiset Place) (T : Finset Transition) :
    T ⊆ N.stubbornStep M T :=
  Finset.subset_union_left

theorem self_mem_closure (M : Multiset Place) (t : Transition) : t ∈ N.closure M t := by
  have : ∀ n, t ∈ (N.stubbornStep M)^[n] {t} := fun n => by
    induction n with
    | zero => exact Finset.mem_singleton_self _
    | succ n ih =>
      rw [Function.iterate_succ_apply']
      exact N.subset_stubbornStep M _ ih
  exact this _

theorem stubbornStep_closure (M : Multiset Place) (t : Transition) :
    N.stubbornStep M (N.closure M t) = N.closure M t :=
  iterate_card_fixed _ (N.subset_stubbornStep M) _

theorem seed_spec {M : Multiset Place} (h : ∃ t, N.pre t ≤ M) :
    ∃ t, N.seed M = some t ∧ N.pre t ≤ M := by
  have hne : (Finset.univ.filter fun t => N.pre t ≤ M).Nonempty :=
    let ⟨t, ht⟩ := h
    ⟨t, Finset.mem_filter.2 ⟨Finset.mem_univ _, ht⟩⟩
  obtain ⟨t, ht, heq⟩ := Finset.mem_image.1 (Finset.min'_mem _ (hne.image fun t =>
    toLex (N.cost M t, t)))
  refine ⟨t, ?_, (Finset.mem_filter.1 ht).2⟩
  simp only [seed, hne, ↓reduceDIte]
  rw [← heq]
  rfl

theorem seed_eq_none {M : Multiset Place} (h : ∀ t, ¬ N.pre t ≤ M) : N.seed M = none := by
  have : ¬ (Finset.univ.filter fun t => N.pre t ≤ M).Nonempty := fun ⟨t, ht⟩ =>
    h t (Finset.mem_filter.1 ht).2
  simp only [seed, this, ↓reduceDIte]

theorem stubbornStep_stubbornFinset (M : Multiset Place) :
    N.stubbornStep M (N.stubbornFinset M) = N.stubbornFinset M := by
  unfold stubbornFinset
  cases N.seed M with
  | none =>
    ext u
    simp [stubbornStep]
  | some t => exact N.stubbornStep_closure M t

theorem mem_of_stubbornRel {M : Multiset Place} {t u : Transition}
    (ht : t ∈ N.stubbornFinset M) (h : N.stubbornRel M t u = true) : u ∈ N.stubbornFinset M := by
  rw [← N.stubbornStep_stubbornFinset M]
  exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, t, ht, h⟩)

variable {N}

omit [LinearOrder Transition] [Fintype Transition] in
theorem conflicts_iff {t u : Transition} :
    N.conflicts t u = true ↔ N.toPetriNet.Conflict t u := by
  simp only [conflicts, decide_eq_true_eq, PetriNet.Conflict, toPetriNet, Multiset.toFinsupp_apply,
    Multiset.mem_toFinset, Multiset.count_pos]

/-- The computed set is closed in the sense of `PetriNet.StubbornClosed`, and hence stubborn. -/
theorem stubbornFinset_closed (M : Multiset Place) :
    StubbornClosed N.toPetriNet (Multiset.toFinsupp M) (N.stubbornFinset M : Set Transition) := by
  refine ⟨fun t ht hen u hu hc => ?_, fun t ht hdis => ?_⟩
  · have hen' : N.pre t ≤ M := enabled_toPetriNet_iff.1 hen
    refine hu (N.mem_of_stubbornRel ht ?_)
    simpa only [stubbornRel, hen', ↓reduceIte] using conflicts_iff.2 hc
  · have hdis' : ¬ N.pre t ≤ M := fun h => hdis (enabled_toPetriNet_iff.2 h)
    obtain ⟨p, hp, hlt⟩ := N.exists_missingPlace hdis'
    refine ⟨p, by simpa [toPetriNet, Multiset.toFinsupp_apply] using hlt, fun u hu => ?_⟩
    by_contra hc
    refine hu (N.mem_of_stubbornRel ht ?_)
    simpa [stubbornRel, hdis', hp, toPetriNet, Multiset.toFinsupp_apply] using hc

/-- The computed set is stubborn. -/
theorem stubbornFinset_isStubborn (M : Multiset Place) :
    IsStubborn N.toPetriNet (Multiset.toFinsupp M) (N.stubbornFinset M : Set Transition) :=
  (stubbornFinset_closed M).isStubborn

/-- At a non-dead marking, the computed set contains an enabled transition. -/
theorem exists_enabled_mem_stubbornFinset {M : Multiset Place}
    (hM : ¬ N.toPetriNet.Dead (Multiset.toFinsupp M)) :
    ∃ t ∈ N.stubbornFinset M, (Multiset.toFinsupp M) [t⟩[N.toPetriNet] := by
  obtain ⟨t, hs, hle⟩ := N.seed_spec (M := M) (by
    by_contra hc
    push Not at hc
    exact hM (dead_toFinsupp_iff.2 hc))
  refine ⟨t, ?_, enabled_toPetriNet_iff.2 hle⟩
  simp only [stubbornFinset, hs]
  exact N.self_mem_closure M t



/-- The selector of `PetriNet.reduced` given by the computed stubborn sets. -/
noncomputable abbrev stubbornSelector (N : ExecPetriNet Place Transition) :
    Marking Place → Set Transition :=
  finsetSelector N.stubbornFinset

theorem stubbornSelector_isStubborn (M : Marking Place) :
    IsStubborn N.toPetriNet M (N.stubbornSelector M) := by
  obtain ⟨M, rfl⟩ := Multiset.toFinsupp.surjective M
  simpa using stubbornFinset_isStubborn (N := N) M

theorem stubbornSelector_exists_enabled (M : Marking Place) (hM : ¬ N.toPetriNet.Dead M) :
    ∃ t ∈ N.stubbornSelector M, M [t⟩[N.toPetriNet] := by
  obtain ⟨M, rfl⟩ := Multiset.toFinsupp.surjective M
  simpa using exists_enabled_mem_stubbornFinset (N := N) hM

/-- A dead marking is reachable from `M` if and only if it is reachable from `M` in the graph
reduced by the computed stubborn sets. -/
theorem canReach_dead_iff_reduced (M : Marking Place) :
    (∃ D, N.toPetriNet.Dead D ∧ M ⇝[N] D) ↔
      ∃ D, N.toPetriNet.Dead D ∧ (N.toPetriNet.reduced N.stubbornSelector).CanReach M D :=
  PetriNet.canReach_dead_iff_reduced_of _ N.stubbornSelector_isStubborn
    N.stubbornSelector_exists_enabled



end Computed

end ExecPetriNet

end Cslib
