module

public import Cslib.Computability.PetriNets.StubbornSets

/-! # A computable stubborn selector

For a net with finitely many transitions, the stubborn set generated by a transition is computed by
iterating a one-step function on finite sets of transitions, as many times as there are
transitions. A transition brings in the transitions that conflict with it (`PetriNet.Conflict`) if
it is enabled, and the transitions that add tokens to its least missing place if it is disabled.
The stubborn set at a marking is the one generated by the enabled transition for which the
generated set contains the fewest enabled transitions, and the least such transition. All choices
need a linear order on transitions and places.

## Main definitions

- `PetriNet.stubbornFinset`: the computed stubborn set at a marking. It is the computable
  counterpart of the noncomputable `PetriNet.stubbornSelector`, and is used as a selector for
  `PetriNet.reduced` through the coercion of finite sets to sets.
- `PetriNet.reducedReachSet`: the markings reachable in at most `n` steps of the graph reduced
  by a computed selector, as a finite set, and `PetriNet.ReducedClosed` says that it is closed.

## Main statements

- `PetriNet.stubbornFinset_closed`: the computed set is `PetriNet.StubbornClosed`, hence
  stubborn.
- `PetriNet.exists_enabled_mem_stubbornFinset`: at a non-dead marking, it contains an enabled
  transition.
- `PetriNet.canReach_dead_iff_reduced_stubbornFinset`: a dead marking is reachable iff it is
  reachable in the graph reduced by the computed stubborn sets.
- `PetriNet.reducedReachSet_subset`: the computed reduced reachable markings are reachable.
-/

@[expose] public section

namespace Cslib

namespace PetriNet

section Iterate

/-- An inflationary self-map of the finite sets of a finite type is stable after as many
iterations as there are elements. -/
theorem iterate_card_fixed {α : Type*} [Fintype α] (f : Finset α → Finset α)
    (hf : ∀ s, s ⊆ f s) (x : Finset α) : f (f^[Fintype.card α] x) = f^[Fintype.card α] x := by
  by_contra hne
  have hstrict : ∀ k ≤ Fintype.card α, f^[k] x ⊂ f (f^[k] x) := by
    intro k hk
    refine (hf _).ssubset_of_ne fun h => hne ?_
    have hfix : f (f^[k] x) = f^[k] x := h.symm
    have : f^[Fintype.card α] x = f^[k] x := by
      obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le hk
      rw [hm, add_comm, Function.iterate_add_apply, Function.iterate_fixed hfix m]
    rw [this]
    exact hfix
  have hcard : ∀ k ≤ Fintype.card α + 1, k ≤ (f^[k] x).card := by
    intro k
    induction k with
    | zero => intro; exact Nat.zero_le _
    | succ k ih =>
      intro hk
      rw [Function.iterate_succ_apply']
      have := Finset.card_lt_card (hstrict k (by omega))
      have := ih (by omega)
      omega
  have := hcard (Fintype.card α + 1) le_rfl
  have := Finset.card_le_univ (f^[Fintype.card α + 1] x)
  omega

end Iterate

variable {Place Transition : Type*}

section Reduced

variable [DecidableEq Place] (N : PetriNet Place Transition)
  (sel : Marking Place → Finset Transition)

/-- The markings reached by one more firing of a transition selected by `sel`, from some marking
in `S`. -/
def reducedStepSet (S : Finset (Marking Place)) : Finset (Marking Place) :=
  S.biUnion fun M => (sel M).biUnion fun t => (N.fire? M t).toFinset

/-- The markings reachable from `M₀` in at most `n` steps of the graph reduced by `sel`. -/
def reducedReachSet (M₀ : Marking Place) : ℕ → Finset (Marking Place)
  | 0 => {M₀}
  | n + 1 => reducedReachSet M₀ n ∪ N.reducedStepSet sel (reducedReachSet M₀ n)

/-- The level `n` of `reducedReachSet` is closed: it contains the markings reached by one more
selected firing. -/
def ReducedClosed (M₀ : Marking Place) (n : ℕ) : Prop :=
  N.reducedStepSet sel (N.reducedReachSet sel M₀ n) ⊆ N.reducedReachSet sel M₀ n

instance (M₀ : Marking Place) (n : ℕ) : Decidable (N.ReducedClosed sel M₀ n) :=
  inferInstanceAs (Decidable (_ ⊆ (_ : Finset (Marking Place))))

variable {N sel}

theorem mem_reducedReachSet_self {M₀ : Marking Place} (n : ℕ) :
    M₀ ∈ N.reducedReachSet sel M₀ n := by
  induction n with
  | zero => exact Finset.mem_singleton_self _
  | succ n ih => exact Finset.mem_union_left _ ih

/-- A path of the reduced graph from a marking in a closed set stays in it. -/
theorem mem_of_reduced_mTr {S : Finset (Marking Place)} (hS : N.reducedStepSet sel S ⊆ S)
    {M M' : Marking Place} {ρ : List Transition} (h : (N.reduced (sel ·)).MTr M ρ M')
    (hM : M ∈ S) : M' ∈ S := by
  induction h with
  | refl => exact hM
  | @stepL M₁ μ M₂ ρ M₃ htr _ ih =>
    obtain ⟨hμ, hf⟩ := htr
    refine ih (hS ?_)
    simp only [reducedStepSet, Finset.mem_biUnion, Option.mem_toFinset]
    exact ⟨M₁, hM, μ, hμ, fire?_eq_some_iff.2 hf⟩

/-- Every marking in `reducedReachSet` is reachable in the reduced graph. -/
theorem reducedReachSet_reachable {M₀ M : Marking Place} {n : ℕ}
    (h : M ∈ N.reducedReachSet sel M₀ n) : (N.reduced (sel ·)).CanReach M₀ M := by
  induction n generalizing M with
  | zero =>
    rw [reducedReachSet, Finset.mem_singleton] at h
    subst h
    exact LTS.CanReach.refl _ _
  | succ n ih =>
    rcases Finset.mem_union.1 h with h | h
    · exact ih h
    · simp only [reducedStepSet, Finset.mem_biUnion, Option.mem_toFinset] at h
      obtain ⟨M', hM', t, ht, hf⟩ := h
      obtain ⟨σ, hσ⟩ := ih hM'
      exact ⟨σ ++ [t], hσ.comp _ (.single _ ⟨ht, fire?_eq_some_iff.1 hf⟩)⟩

/-- The computed reduced reachable markings are reachable markings of the net. -/
theorem reducedReachSet_subset {M₀ M : Marking Place} {n : ℕ}
    (h : M ∈ N.reducedReachSet sel M₀ n) : M₀ ⇝[N] M :=
  let ⟨ρ, hρ⟩ := reducedReachSet_reachable h
  ⟨ρ, hρ.of_reduced⟩

end Reduced

section Computed

variable [LinearOrder Place] (N : PetriNet Place Transition)

/-- The least place where the marking `M` has fewer tokens than the preset of `t` requires, if
there is one. -/
def missingPlace (M : Marking Place) (t : Transition) : Option Place :=
  let s := (•[N] t).toFinset.filter fun p => M.count p < (•[N] t).count p
  if h : s.Nonempty then some (s.min' h) else none

/-- `missingPlace` finds a place that is missing tokens. -/
theorem count_lt_of_mem_missingPlace {M : Marking Place} {t : Transition} {p : Place}
    (h : p ∈ N.missingPlace M t) : M.count p < (•[N] t).count p := by
  simp only [missingPlace] at h
  split_ifs at h with hne
  · cases Option.mem_some_iff.1 h
    exact (Finset.mem_filter.1 (Finset.min'_mem _ hne)).2
  · cases h

/-- A disabled transition has a missing place, and `missingPlace` finds one. -/
theorem exists_mem_missingPlace {M : Marking Place} {t : Transition} (h : ¬ M [t⟩[N]) :
    ∃ p, p ∈ N.missingPlace M t := by
  obtain ⟨q, hq⟩ := exists_missing h
  have hne : ((•[N] t).toFinset.filter fun p => M.count p < (•[N] t).count p).Nonempty :=
    ⟨q, Finset.mem_filter.2 ⟨Multiset.mem_toFinset.2 (Multiset.count_pos.1 (by omega)), hq⟩⟩
  exact ⟨_, by simp only [missingPlace, hne, ↓reduceDIte]; rfl⟩

/-- The transition `u` is brought in by `t` in the computed stubborn closure at `M`: if `t` is
enabled, when `u` is in conflict with `t`, and if `t` is disabled, when `u` adds tokens to the
least place that `t` is short of. It is contained in `StubbornRel`. -/
def StubbornRelMin (M : Marking Place) (t u : Transition) : Prop :=
  (M [t⟩[N] ∧ N.Conflict t u) ∨
    (¬ M [t⟩[N] ∧ ∃ p ∈ N.missingPlace M t, (•[N] u).count p < (u •[N]).count p)

instance (M : Marking Place) (t u : Transition) : Decidable (N.StubbornRelMin M t u) :=
  inferInstanceAs (Decidable (_ ∨ _))

variable [LinearOrder Transition] [Fintype Transition]

/-- One step of the closure: add the transitions brought in by the members. -/
def stubbornStep (M : Marking Place) (T : Finset Transition) : Finset Transition :=
  T ∪ Finset.univ.filter fun u => ∃ t ∈ T, N.StubbornRelMin M t u

/-- The stubborn set generated by `t` at `M`. -/
def stubbornClosure (M : Marking Place) (t : Transition) : Finset Transition :=
  (N.stubbornStep M)^[Fintype.card Transition] {t}

/-- The number of enabled transitions in the set generated by `t` at `M`. -/
def stubbornCost (M : Marking Place) (t : Transition) : ℕ :=
  ((N.stubbornClosure M t).filter fun u => M [u⟩[N]).card

/-- The enabled transition with the cheapest generated set, and the least such transition, if
there is an enabled transition. -/
def stubbornSeed (M : Marking Place) : Option Transition :=
  let s := Finset.univ.filter fun t => (M [t⟩[N])
  if h : s.Nonempty then
    some (ofLex ((s.image fun t => toLex (N.stubbornCost M t, t)).min' (h.image _))).2
  else none

/-- The computed stubborn set at `M`, which is empty at dead markings. -/
def stubbornFinset (M : Marking Place) : Finset Transition :=
  match N.stubbornSeed M with
  | none => ∅
  | some t => N.stubbornClosure M t

theorem subset_stubbornStep (M : Marking Place) (T : Finset Transition) :
    T ⊆ N.stubbornStep M T :=
  Finset.subset_union_left

theorem self_mem_stubbornClosure (M : Marking Place) (t : Transition) :
    t ∈ N.stubbornClosure M t := by
  have : ∀ n, t ∈ (N.stubbornStep M)^[n] {t} := fun n => by
    induction n with
    | zero => exact Finset.mem_singleton_self _
    | succ n ih =>
      rw [Function.iterate_succ_apply']
      exact N.subset_stubbornStep M _ ih
  exact this _

theorem stubbornStep_stubbornClosure (M : Marking Place) (t : Transition) :
    N.stubbornStep M (N.stubbornClosure M t) = N.stubbornClosure M t :=
  iterate_card_fixed _ (N.subset_stubbornStep M) _

theorem stubbornSeed_spec {M : Marking Place} (h : ∃ t, M [t⟩[N]) :
    ∃ t, N.stubbornSeed M = some t ∧ M [t⟩[N] := by
  have hne : (Finset.univ.filter fun t => M [t⟩[N]).Nonempty :=
    let ⟨t, ht⟩ := h
    ⟨t, Finset.mem_filter.2 ⟨Finset.mem_univ _, ht⟩⟩
  obtain ⟨t, ht, heq⟩ := Finset.mem_image.1 (Finset.min'_mem _ (hne.image fun t =>
    toLex (N.stubbornCost M t, t)))
  refine ⟨t, ?_, (Finset.mem_filter.1 ht).2⟩
  simp only [stubbornSeed, hne, ↓reduceDIte]
  rw [← heq]
  rfl

theorem stubbornStep_stubbornFinset (M : Marking Place) :
    N.stubbornStep M (N.stubbornFinset M) = N.stubbornFinset M := by
  unfold stubbornFinset
  cases N.stubbornSeed M with
  | none =>
    ext u
    simp [stubbornStep]
  | some t => exact N.stubbornStep_stubbornClosure M t

theorem mem_of_stubbornRelMin {M : Marking Place} {t u : Transition}
    (ht : t ∈ N.stubbornFinset M) (h : N.StubbornRelMin M t u) : u ∈ N.stubbornFinset M := by
  rw [← N.stubbornStep_stubbornFinset M]
  exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, t, ht, h⟩)

variable {N}

/-- The computed set is closed in the sense of `PetriNet.StubbornClosed`, and hence stubborn. -/
theorem stubbornFinset_closed (M : Marking Place) :
    StubbornClosed N M (N.stubbornFinset M : Set Transition) := by
  refine ⟨fun t ht hen u hu hc => hu (N.mem_of_stubbornRelMin ht (.inl ⟨hen, hc⟩)),
    fun t ht hdis => ?_⟩
  obtain ⟨p, hp⟩ := N.exists_mem_missingPlace hdis
  refine ⟨p, N.count_lt_of_mem_missingPlace hp, fun u hu => ?_⟩
  by_contra hc
  exact hu (N.mem_of_stubbornRelMin ht (.inr ⟨hdis, p, hp, not_le.1 hc⟩))

/-- The computed set is stubborn. -/
theorem stubbornFinset_isStubborn (M : Marking Place) :
    IsStubborn N M (N.stubbornFinset M : Set Transition) :=
  (stubbornFinset_closed M).isStubborn

/-- At a non-dead marking, the computed set contains an enabled transition. -/
theorem exists_enabled_mem_stubbornFinset {M : Marking Place} (hM : ¬ N.Dead M) :
    ∃ t ∈ N.stubbornFinset M, M [t⟩[N] := by
  obtain ⟨t, hs, hen⟩ := N.stubbornSeed_spec (M := M) (by
    by_contra hc
    push Not at hc
    exact hM (dead_iff.2 hc))
  refine ⟨t, ?_, hen⟩
  simp only [stubbornFinset, hs]
  exact N.self_mem_stubbornClosure M t

/-- A dead marking is reachable from `M` if and only if it is reachable from `M` in the graph
reduced by the computed stubborn sets. -/
theorem canReach_dead_iff_reduced_stubbornFinset (M : Marking Place) :
    (∃ D, N.Dead D ∧ M ⇝[N] D) ↔
      ∃ D, N.Dead D ∧ (N.reduced (N.stubbornFinset ·)).CanReach M D :=
  canReach_dead_iff_reduced_of _ stubbornFinset_isStubborn
    fun _ hM => exists_enabled_mem_stubbornFinset hM

end Computed

end PetriNet

end Cslib
