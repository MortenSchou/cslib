module

public import Cslib.Computability.PetriNets.Coverability
public import Mathlib.Data.Finsupp.PWO
public import Mathlib.Order.WellFoundedSet

/-! # Finite basis for coverability

The markings from which a given marking is coverable form an upward-closed set (adding tokens
preserves coverability). Over finitely many places, markings are well-quasi-ordered by Dickson's
lemma, so every upward-closed set is generated by finitely many minimal elements. This is the
mathematical core of backward coverability algorithms.

## Main statements

- `exists_finite_basis`: in a well-quasi-order, every upward-closed set is generated by a finite
  set of its elements.
- `PetriNet.exists_finite_basis_coverable`: for each target marking, the markings from which it is
  coverable are generated by a finite basis.
-/

@[expose] public section

namespace Cslib

/-- In a well-quasi-ordered partial order, every upward-closed set is generated by a finite set of
its elements, namely its minimal elements. -/
theorem exists_finite_basis {α : Type*} [PartialOrder α] [WellQuasiOrderedLE α] {U : Set α}
    (hU : IsUpperSet U) :
    ∃ B : Set α, B.Finite ∧ B ⊆ U ∧ ∀ x, x ∈ U ↔ ∃ b ∈ B, b ≤ x := by
  refine ⟨{b | Minimal (· ∈ U) b}, ?_, fun b hb => hb.1, fun x => ⟨fun hx => ?_, ?_⟩⟩
  · refine WellQuasiOrderedLE.finite_of_isAntichain fun a ha b hb hne hab => hne ?_
    exact le_antisymm hab (hb.2 ha.1 hab)
  · obtain ⟨b, hbx, hb⟩ := (Set.isPWO_of_wellQuasiOrderedLE U).exists_le_minimal hx
    exact ⟨b, hb, hbx⟩
  · rintro ⟨b, hb, hbx⟩
    exact hU hbx hb.1

namespace PetriNet

variable {Place : Type*} {Transition : Type*} {N : PetriNet Place Transition}

/-- Over finitely many places, the markings from which a target is coverable are generated by a
finite basis. -/
theorem exists_finite_basis_coverable [Finite Place] (M : Marking Place) :
    ∃ B : Set (Marking Place), B.Finite ∧ ∀ M₀, N.Coverable M₀ M ↔ ∃ b ∈ B, b ≤ M₀ := by
  have hU : IsUpperSet {M₀ | N.Coverable M₀ M} := fun _ _ hle h => h.mono_source hle
  obtain ⟨B, hB, -, hiff⟩ := exists_finite_basis hU
  exact ⟨B, hB, hiff⟩

end PetriNet

end Cslib
