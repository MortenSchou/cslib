module

public import Cslib.Computability.WSTS.Coverability
public import Cslib.Foundations.Data.Search
public import Mathlib.Data.Finset.Union

/-! # Decidability of coverability from an effective predecessor basis

The backward iteration of `Cslib.WSTS.backSeq` works on infinite upper sets. It becomes an
algorithm when the sets are represented by finite bases and one can compute a basis of the
predecessors of the upper set generated by a finite set (the *effective pred-basis* assumption of
Abdulla et al.). We model the oracle as a function `pb : Finset State → Finset State` that is
correct in the sense of `IsPredBasis`, iterate it on finite sets, and decide stabilisation by the
finite test `Stable`.

The search for the first stable iterate uses `searchIter`, so that the resulting decision
procedure can be evaluated by `decide` (see `Cslib.Foundations.Data.Search`).

## Main definitions

- `Cslib.WSTS.gen`: the upper set generated by a finite set.
- `Cslib.WSTS.IsPredBasis`: `pb B` generates the predecessors of the upper set generated by `B`.
- `Cslib.WSTS.basisSeq`: the backward iteration on finite bases.
- `Cslib.WSTS.Stable`: the decidable test that the iteration has converged.
- `Cslib.WSTS.stableBasis`: the first stable iterate.
- `Cslib.WSTS.decidableCoverable`: coverability is decidable, given decidable `≤`, decidable
  equality, and an effective pred-basis.

## Main statements

- `Cslib.WSTS.gen_basisSeq`: the finite iteration generates the backward iteration.
- `Cslib.WSTS.exists_stable`: the iteration is eventually stable, so the search terminates.
- `Cslib.WSTS.coverable_iff_exists_stableBasis`: coverability is membership in the set generated
  by the first stable basis.
-/

@[expose] public section

namespace Cslib

namespace WSTS

variable {State : Type*} {Label : Type*} [Preorder State] (lts : LTS State Label)

/-- The upper set generated by a finite set of states. -/
def gen (B : Finset State) : Set State :=
  {s | ∃ b ∈ B, b ≤ s}

variable {lts}

theorem gen_union (B B' : Finset State) [DecidableEq State] :
    gen (B ∪ B') = gen B ∪ gen B' :=
  Set.ext fun _ =>
    ⟨fun ⟨b, hb, hbs⟩ => (Finset.mem_union.1 hb).imp (⟨b, ·, hbs⟩) (⟨b, ·, hbs⟩),
      fun h => h.elim (fun ⟨b, hb, hbs⟩ => ⟨b, Finset.mem_union_left _ hb, hbs⟩)
        fun ⟨b, hb, hbs⟩ => ⟨b, Finset.mem_union_right _ hb, hbs⟩⟩

theorem gen_singleton (t : State) : gen {t} = Set.Ici t :=
  Set.ext fun _ =>
    ⟨fun ⟨_, hb, hbs⟩ => (Finset.mem_singleton.1 hb) ▸ hbs,
      fun h => ⟨t, Finset.mem_singleton_self t, h⟩⟩

variable (lts)

/-- An *effective pred-basis* for `lts`: a function on finite sets of states such that `pb B`
generates exactly the states with a step into the upper set generated by `B`. -/
def IsPredBasis (pb : Finset State → Finset State) : Prop :=
  ∀ B, gen (pb B) = predSet lts (gen B)

variable {lts} [DecidableEq State] (pb : Finset State → Finset State) (t : State)

/-- The backward iteration on finite bases: keep the basis and add the pred-basis. -/
def basisSeq (n : ℕ) : Finset State :=
  (fun B => B ∪ pb B)^[n] {t}

omit [Preorder State] in
theorem basisSeq_succ (n : ℕ) :
    basisSeq pb t (n + 1) = basisSeq pb t n ∪ pb (basisSeq pb t n) := by
  rw [basisSeq, Function.iterate_succ_apply']; rfl

variable {pb}

/-- The finite iteration generates the backward iteration. -/
theorem gen_basisSeq (h : IsPredBasis lts pb) (n : ℕ) :
    gen (basisSeq pb t n) = backSeq lts t n := by
  induction n with
  | zero => exact gen_singleton t
  | succ n ih => rw [basisSeq_succ, gen_union, h, ih, backSeq_succ, backStep]

variable (pb)

/-- The finite stabilisation test: every element of the pred-basis is above an element of the
current basis. It is decidable whenever `≤` is. -/
def Stable (B : Finset State) : Prop :=
  ∀ x ∈ pb B, ∃ b ∈ B, b ≤ x

instance [DecidableRel (α := State) (· ≤ ·)] (B : Finset State) : Decidable (Stable pb B) :=
  inferInstanceAs (Decidable (∀ x ∈ pb B, ∃ b ∈ B, b ≤ x))

variable {pb}

theorem stable_iff (h : IsPredBasis lts pb) (n : ℕ) :
    Stable pb (basisSeq pb t n) ↔ backSeq lts t (n + 1) ⊆ backSeq lts t n := by
  rw [← gen_basisSeq t h, ← gen_basisSeq t h, basisSeq_succ, gen_union]
  constructor
  · intro hst s hs
    rcases hs with hs | ⟨x, hx, hxs⟩
    · exact hs
    · obtain ⟨a, ha, hax⟩ := hst x hx
      exact ⟨a, ha, hax.trans hxs⟩
  · intro hsub x hx
    exact hsub (Or.inr ⟨x, hx, le_rfl⟩)

/-- The stabilisation test succeeds at some stage, so the search terminates. -/
theorem exists_stable [WSTS lts] (h : IsPredBasis lts pb) :
    ∃ n, Stable pb (basisSeq pb t n) := by
  obtain ⟨n, hfix, -⟩ := exists_backSeq_fixpoint (lts := lts) t
  refine ⟨n, (stable_iff t h n).2 ?_⟩
  rw [backSeq_succ, hfix]

/-- At a stable stage, coverability is membership in the set generated by the finite basis. -/
theorem coverable_iff_of_stable [WSTS lts] (h : IsPredBasis lts pb) {n : ℕ}
    (hn : Stable pb (basisSeq pb t n)) (s : State) :
    Coverable lts s t ↔ ∃ b ∈ basisSeq pb t n, b ≤ s := by
  obtain ⟨m, hfix, hiff⟩ := exists_backSeq_fixpoint (lts := lts) t
  have hfixn : backStep lts (backSeq lts t n) = backSeq lts t n := by
    rw [← backSeq_succ]
    exact Set.Subset.antisymm ((stable_iff t h n).1 hn) (backSeq_mono t n.le_succ)
  have hmem : ∀ s, Coverable lts s t ↔ s ∈ backSeq lts t n := fun s => by
    rw [hiff, ← backSeq_eq_of_fixpoint hfix (le_max_left m n),
      ← backSeq_eq_of_fixpoint hfixn (le_max_right m n)]
  rw [hmem, ← gen_basisSeq t h]
  exact Iff.rfl

variable [DecidableRel (α := State) (· ≤ ·)]

/-- The first stable iterate of the backward iteration from the target `t`. -/
def stableBasis [WSTS lts] (h : IsPredBasis lts pb) : Finset State :=
  searchIter (fun B => B ∪ pb B) (Stable pb) {t} (exists_stable t h)

theorem stableBasis_spec [WSTS lts] (h : IsPredBasis lts pb) :
    ∃ n, stableBasis t h = basisSeq pb t n ∧ Stable pb (stableBasis t h) :=
  searchIter_spec (fun B => B ∪ pb B) (Stable pb) {t} (exists_stable t h)

/-- Coverability is decided by comparing with the first stable basis. -/
theorem coverable_iff_exists_stableBasis [WSTS lts] (h : IsPredBasis lts pb) (s : State) :
    Coverable lts s t ↔ ∃ b ∈ stableBasis t h, b ≤ s := by
  obtain ⟨n, hn, hs⟩ := stableBasis_spec t h
  rw [hn] at hs ⊢
  exact coverable_iff_of_stable t h hs s

/-- Coverability in a WSTS with decidable `≤`, decidable equality, and an effective pred-basis is
decidable: iterate the pred-basis until the finite stabilisation test succeeds, then test whether
some basis element is below the source. -/
def decidableCoverable [WSTS lts] (h : IsPredBasis lts pb) (s t : State) :
    Decidable (Coverable lts s t) :=
  decidable_of_iff _ (coverable_iff_exists_stableBasis t h s).symm

end WSTS

end Cslib
