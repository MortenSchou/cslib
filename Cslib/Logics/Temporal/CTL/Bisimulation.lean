module

public import Cslib.Logics.Temporal.CTL.Semantics
public import Cslib.Foundations.Semantics.LTS.Bisimulation

/-! # Bisimulation invariance of CTL

Bisimilar states of labelled transition systems satisfy the same CTL formulas, in the models given
by the LTSs and a valuation of atoms that agrees on related states. This uses the bisimulations of
`Cslib.Foundations.Semantics.LTS.Bisimulation`.

CTL is sensitive to deadlocks, which bisimulations preserve since they preserve having a successor,
and quantifies over maximal paths, which can be lifted along a bisimulation (`lift_path`).

## Main statements

- `lift_path`: a maximal path lifts along a bisimulation.
- `RespectsAtoms`: the condition on the valuations for related states to satisfy the same atoms.
- `Satisfies.of_isBisimulation`: states related by a bisimulation satisfy the same formulas.
- `Satisfies.of_bisimilar`: bisimilar states satisfy the same formulas.
- `Satisfies.generatedBy_iff`: satisfaction in the LTS generated by a state.
-/

@[expose] public section

namespace Cslib.Logic.CTL

open Cslib
open scoped InferenceSystem Formula Cslib.Logic

variable {S₁ S₂ : Type*} {Label : Type*} {Atom : Type*} {lts₁ : LTS S₁ Label}
  {lts₂ : LTS S₂ Label} {v₁ : S₁ → Atom → Prop} {v₂ : S₂ → Atom → Prop} {r : S₁ → S₂ → Prop}

/-- The relation `r` relates states that satisfy the same atoms. The bisimulations of LTSs only
constrain the transitions, so this is the condition on the valuations `v₁` and `v₂` needed for
related states to satisfy the same formulas. -/
def RespectsAtoms (r : S₁ → S₂ → Prop) (v₁ : S₁ → Atom → Prop) (v₂ : S₂ → Atom → Prop) : Prop :=
  ∀ s t, r s t → ∀ p, v₁ s p ↔ v₂ t p

/-- Related states are both deadlocks, or neither. -/
theorem dead_iff_of_isBisimulation (hr : LTS.IsBisimulation lts₁ lts₂ r) {s t} (hst : r s t) :
    Model.Dead ⟨lts₁, v₁⟩ s ↔ Model.Dead ⟨lts₂, v₂⟩ t :=
  ⟨fun hd t' ⟨μ, htr⟩ => by
    obtain ⟨s', hs', _⟩ := (hr hst μ).2 t' htr
    exact hd s' ⟨μ, hs'⟩,
   fun hd s' ⟨μ, htr⟩ => by
    obtain ⟨t', ht', _⟩ := (hr hst μ).1 s' htr
    exact hd t' ⟨μ, ht'⟩⟩

/-- A maximal path from a state lifts along a bisimulation to a maximal path from every state
related to its start, staying related. -/
theorem lift_path (hr : LTS.IsBisimulation lts₁ lts₂ r) {f : ℕ → S₁}
    (hf : Model.IsPath ⟨lts₁, v₁⟩ f) {t : S₂} (h0 : r (f 0) t) :
    ∃ g, Model.IsPath ⟨lts₂, v₂⟩ g ∧ g 0 = t ∧ ∀ n, r (f n) (g n) := by
  have step : ∀ n (x : {t // r (f n) t}), ∃ y : {t // r (f (n + 1)) t},
      Model.tr ⟨lts₂, v₂⟩ x.1 y.1 ∨ (Model.Dead ⟨lts₂, v₂⟩ x.1 ∧ y.1 = x.1) := fun n x => by
    rcases hf n with ⟨μ, htr⟩ | ⟨hd, heq⟩
    · obtain ⟨t', htr', hr'⟩ := (hr x.2 μ).1 _ htr
      exact ⟨⟨t', hr'⟩, Or.inl ⟨μ, htr'⟩⟩
    · exact ⟨⟨x.1, by rw [heq]; exact x.2⟩,
        Or.inr ⟨(dead_iff_of_isBisimulation hr x.2).1 hd, rfl⟩⟩
  choose next hnext using step
  let G : ∀ n, {t // r (f n) t} := fun n => Nat.rec ⟨t, h0⟩ (fun n x => next n x) n
  exact ⟨fun n => (G n).1, fun n => hnext n (G n), rfl, fun n => (G n).2⟩

/-- **Bisimilar states satisfy the same CTL formulas.** States related by a bisimulation of LTSs
satisfy the same formulas, if related states satisfy the same atoms. -/
theorem Satisfies.of_isBisimulation (hr : LTS.IsBisimulation lts₁ lts₂ r)
    (hv : RespectsAtoms r v₁ v₂) (φ : Formula Atom) :
    ∀ {s t}, r s t → (⇓CTL[⟨lts₁, v₁⟩,s ⊨ φ] ↔ ⇓CTL[⟨lts₂, v₂⟩,t ⊨ φ]) := by
  have hr' := hr.inv
  induction φ with
  | atom p => exact fun hst => hv _ _ hst p
  | false => exact fun _ => Iff.rfl
  | not φ ih => exact fun hst => not_congr (ih hst)
  | or φ ψ ihφ ihψ => exact fun hst => or_congr (ihφ hst) (ihψ hst)
  | ex φ ih =>
    intro s t hst
    constructor
    · rintro ⟨s', ⟨μ, htr⟩, hs⟩
      obtain ⟨t', htr', hZ'⟩ := (hr hst μ).1 s' htr
      exact ⟨t', ⟨μ, htr'⟩, (ih hZ').1 hs⟩
    · rintro ⟨t', ⟨μ, htr⟩, ht⟩
      obtain ⟨s', htr', hZ'⟩ := (hr hst μ).2 t' htr
      exact ⟨s', ⟨μ, htr'⟩, (ih hZ').2 ht⟩
  | eu φ ψ ihφ ihψ =>
    intro s t hst
    constructor
    · rintro ⟨f, hf, h0, n, hn, hk⟩
      obtain ⟨g, hg, hg0, hZg⟩ := lift_path (v₂ := v₂) hr hf (t := t) (by rw [h0]; exact hst)
      exact ⟨g, hg, hg0, n, (ihψ (hZg n)).1 hn, fun k hk' => (ihφ (hZg k)).1 (hk k hk')⟩
    · rintro ⟨g, hg, hg0, n, hn, hk⟩
      obtain ⟨f, hf, hf0, hZf⟩ := lift_path (v₂ := v₁) hr' hg (t := s) (by rw [hg0]; exact hst)
      exact ⟨f, hf, hf0, n, (ihψ (hZf n)).2 hn, fun k hk' => (ihφ (hZf k)).2 (hk k hk')⟩
  | eg φ ih =>
    intro s t hst
    constructor
    · rintro ⟨f, hf, h0, hall⟩
      obtain ⟨g, hg, hg0, hZg⟩ := lift_path (v₂ := v₂) hr hf (t := t) (by rw [h0]; exact hst)
      exact ⟨g, hg, hg0, fun n => (ih (hZg n)).1 (hall n)⟩
    · rintro ⟨g, hg, hg0, hall⟩
      obtain ⟨f, hf, hf0, hZf⟩ := lift_path (v₂ := v₁) hr' hg (t := s) (by rw [hg0]; exact hst)
      exact ⟨f, hf, hf0, fun n => (ih (hZf n)).2 (hall n)⟩

open LTS in
/-- **Bisimilar states of LTSs satisfy the same CTL formulas**, if the atoms hold in bisimilar
states alike. -/
theorem Satisfies.of_bisimilar (hv : RespectsAtoms (Bisimilarity lts₁ lts₂) v₁ v₂)
    {s : S₁} {t : S₂} (hst : Bisimilarity lts₁ lts₂ s t) (φ : Formula Atom) :
    ⇓CTL[⟨lts₁, v₁⟩,s ⊨ φ] ↔ ⇓CTL[⟨lts₂, v₂⟩,t ⊨ φ] :=
  Satisfies.of_isBisimulation (Bisimilarity.isBisimulation lts₁ lts₂) hv φ hst

/-- Satisfaction at a state is satisfaction at the same state in the LTS it generates. -/
theorem Satisfies.generatedBy_iff (lts : LTS S₁ Label) (v : S₁ → Atom → Prop) (s : S₁)
    (a : {s' // lts.CanReach s s'}) (φ : Formula Atom) :
    ⇓CTL[⟨lts.generatedBy s, fun a p => v a.1 p⟩,a ⊨ φ] ↔ ⇓CTL[⟨lts, v⟩,a.1 ⊨ φ] := by
  refine Satisfies.of_isBisimulation (r := fun a s' => a.1 = s') (fun a _ hr μ => ?_)
    (fun _ _ h p => by subst h; exact Iff.rfl) φ rfl
  subst hr
  refine ⟨fun b ⟨_, _, htr⟩ => ⟨b.1, htr, rfl⟩, fun t' htr => ?_⟩
  have hreach : lts.CanReach s t' :=
    (LTS.reflTransGen_unlabelledTr_iff lts).1
      (((LTS.reflTransGen_unlabelledTr_iff lts).2 a.2).tail ⟨μ, htr⟩)
  exact ⟨⟨t', hreach⟩, ⟨a.2, hreach, htr⟩, rfl⟩

end Cslib.Logic.CTL
